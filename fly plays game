              "<script>\n",
              "\"use strict\";\n",
              "const AC=new(window.AudioContext||window.webkitAudioContext)(),$=id=>document.getElementById(id);\n",
              "const cv=$(\"game\"),g=cv.getContext(\"2d\");\n",
              "const COL=[\"#cbd5e1\",\"#7fa8c9\",\"#b39ddb\",\"#c9a227\"],RGB=[\"203,213,225\",\"127,168,201\",\"179,157,219\",\"201,162,39\"];\n",
              "const KEYS=[\"d\",\"f\",\"j\",\"k\"],BANDS=[[20,180],[180,900],[900,3200],[3200,10000]],Z=5;\n",
              "const FONT=s=>`${s} system-ui,-apple-system,'Segoe UI',Roboto,sans-serif`;\n",
              "const setStatus=t=>$(\"status\").textContent=t,round3=x=>Math.round(x*1000)/1000,tick=()=>new Promise(r=>setTimeout(r));\n",
              "let buf=null,feat=null,src=null,chart=null,ns=[],editing=false,selLane=0,playing=false,t0=0,off0=0;\n",
              "let score=0,combo=0,maxCombo=0,judge={t:\"\",at:0,k:\"\"},counts={P:0,G:0,O:0,M:0},result=null;\n",
              "let active=[false,false,false,false],touches=new Map(),parts=[],rings=[],flash=[0,0,0,0],pulse=0,cs=1;\n",
              "const analyser=AC.createAnalyser();analyser.fftSize=256;analyser.smoothingTimeConstant=.78;analyser.connect(AC.destination);\n",
              "const fdata=new Uint8Array(analyser.frequencyBinCount);\n",
              "\n",
              "let W=0,H=0;\n",
              "function resize(){const d=devicePixelRatio||1;W=cv.clientWidth;H=cv.clientHeight;cv.width=W*d;cv.height=H*d;g.setTransform(d,0,0,d,0,0);}\n",
              "new ResizeObserver(resize).observe(cv);\n",
              "function rr(x,y,w,h,r){r=Math.max(0,Math.min(r,w/2,h/2));g.beginPath();g.moveTo(x+r,y);g.arcTo(x+w,y,x+w,y+h,r);g.arcTo(x+w,y+h,x,y+h,r);g.arcTo(x,y+h,x,y,r);g.arcTo(x,y,x+w,y,r);g.closePath();}\n",
              "function geom(){const hy=H*.2,hitY=H*.82;return{cx:W/2,hy,hitY,hw:Math.min(W*.46,(hitY-hy)*.9)};}\n",
              "\n",
              "/* ---------- Analysis ---------- */\n",
              "function fft(re,im){const n=re.length;\n",
              "  for(let i=1,j=0;i<n;i++){let b=n>>1;for(;j&b;b>>=1)j^=b;j^=b;if(i<j){let t=re[i];re[i]=re[j];re[j]=t;t=im[i];im[i]=im[j];im[j]=t;}}\n",
              "  for(let len=2;len<=n;len<<=1){const a=-2*Math.PI/len,wr=Math.cos(a),wi=Math.sin(a),h=len>>1;\n",
              "    for(let i=0;i<n;i+=len){let cr=1,ci=0;for(let j=0;j<h;j++){const u=i+j,v=u+h,xr=re[v]*cr-im[v]*ci,xi=re[v]*ci+im[v]*cr;\n",
              "      re[v]=re[u]-xr;im[v]=im[u]-xi;re[u]+=xr;im[u]+=xi;const nr=cr*wr-ci*wi;ci=cr*wi+ci*wr;cr=nr;}}}}\n",
              "\n",
              "// Stage 1 (slow, cached per song): per-band spectral flux + tempo/phase + fine attack envelope\n",
              "async function extract(b){\n",
              "  const dec=Math.max(1,Math.round(b.sampleRate/22050)),sr=b.sampleRate/dec,n=Math.floor(b.length/dec);\n",
              "  const chs=[];for(let i=0;i<b.numberOfChannels;i++)chs.push(b.getChannelData(i));\n",
              "  const mono=new Float32Array(n);\n",
              "  for(let i=0;i<n;i++){let s=0;for(let d=0;d<dec;d++)for(const c of chs)s+=c[i*dec+d];mono[i]=s/(dec*chs.length);}\n",
              "  // fine attack envelope (|first difference|, 2 ms box): used to place each onset at the real waveform attack\n",
              "  const ae=new Float32Array(n),bw=Math.max(2,Math.round(sr*.002));\n",
              "  {let acc=0;const q=new Float32Array(bw);for(let i=1;i<n;i++){const v=Math.abs(mono[i]-mono[i-1]);acc+=v-q[i%bw];q[i%bw]=v;ae[i]=acc/bw;}}\n",
              "  const N=1024,HOP=256,F=Math.floor((n-N)/HOP);if(F<100)return null;\n",
              "  const win=new Float32Array(N);for(let i=0;i<N;i++)win[i]=.5-.5*Math.cos(2*Math.PI*i/(N-1));\n",
              "  const bandOf=new Int8Array(N/2).fill(-1),cntB=[0,0,0,0];\n",
              "  BANDS.forEach(([a,z],i)=>{for(let k=Math.max(1,Math.round(a*N/sr));k<=Math.min(N/2-1,Math.round(z*N/sr));k++){bandOf[k]=i;cntB[i]++;}});\n",
              "  const re=new Float32Array(N),im=new Float32Array(N),prev=new Float32Array(N/2);\n",
              "  const flux=[0,1,2,3].map(()=>new Float32Array(F)),en=[0,1,2,3].map(()=>new Float32Array(F));\n",
              "  for(let f=0;f<F;f++){\n",
              "    const o=f*HOP;for(let i=0;i<N;i++){re[i]=mono[o+i]*win[i];im[i]=0;}\n",
              "    fft(re,im);\n",
              "    for(let k=1;k<N/2;k++){const m=Math.log1p(300*Math.hypot(re[k],im[k])/N),d=m-prev[k];prev[k]=m;const bd=bandOf[k];if(bd<0)continue;if(d>0)flux[bd][f]+=d;en[bd][f]+=m;}\n",
              "    if(f%300===0){setStatus(`分析频谱 ${Math.round(f/F*100)}%`);await tick();}\n",
              "  }\n",
              "  // one shared scale for all bands: a loud change counts for more than a tiny change in a quiet band\n",
              "  const mm=flux.map((a,b2)=>{let m=0;for(let f=0;f<F;f++)m+=a[f];return(m/F||1e-9)/Math.max(1,cntB[b2]);});\n",
              "  const G=mm.reduce((x,y)=>x+y,0)/4,bmean=mm.map(v=>v/G);\n",
              "  const nflux=[],floor=[],med=[];\n",
              "  for(let b2=0;b2<4;b2++){\n",
              "    nflux.push(flux[b2].map(v=>v/Math.max(1,cntB[b2])/G));\n",
              "    const s=new Float32Array(F);for(let f=3;f<F-3;f++){let a=0;for(let j=-3;j<=3;j++)a+=en[b2][f+j];s[f]=a/7;}\n",
              "    en[b2]=s;const so=Float32Array.from(s).sort();floor.push(so[Math.floor(F*.1)]);med.push(so[F>>1]);\n",
              "  }\n",
              "  setStatus(\"估计节拍…\");await tick();\n",
              "  const sm=new Float32Array(F),dt=HOP/sr;\n",
              "  for(let f=2;f<F-2;f++){let a=0;for(let b2=0;b2<4;b2++){const x=nflux[b2];a+=x[f-2]+2*x[f-1]+3*x[f]+2*x[f+1]+x[f+2];}sm[f]=a/9;}\n",
              "  let mu=0;for(const v of sm)mu+=v;mu/=F;for(let f=0;f<F;f++)sm[f]=Math.max(0,sm[f]-mu);\n",
              "  let avg=0;for(const v of sm)avg+=v;avg=avg/F||1e-9;\n",
              "  const comb=bpm=>{const L=60/bpm/dt;let best=-1,bp=0;\n",
              "    for(let p=0;p<L;p++){let s=0,c=0;for(let k=0;;k++){const i=Math.round(p+k*L);if(i>=F)break;s+=sm[i];c++;}s/=c;if(s>best){best=s;bp=p;}}\n",
              "    return{s:best,p:bp};};\n",
              "  let bb=120,bs=-1;\n",
              "  for(let x=70;x<=180;x+=.1){const w=Math.exp(-.5*Math.pow(Math.log2(x/120)/.7,2)),r=comb(x);if(r.s*w>bs){bs=r.s*w;bb=x;}}\n",
              "  let bp=0,raw=0,c0=bb;\n",
              "  for(let x=c0-.15;x<=c0+.15;x+=.01){const r=comb(x);if(r.s>raw){raw=r.s;bb=x;bp=r.p;}}\n",
              "  return{sr,N,HOP,F,dt,ae,nflux,bmean,en,floor,med,bpm:bb,off:(bp*HOP+N/2)/sr,conf:raw/avg};\n",
              "}\n",
              "\n",
              "// Stage 2 (fast, re-run when any slider changes): rank events by importance, keep the best, spread them over lanes\n",
              "const LEAD=.015;   // fallback only: seconds added to the STFT-based attack time when the waveform has no clear attack\n",
              "function mulberry(a){return()=>{a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}\n",
              "function build(ft,diff,holdsOn,variety,imp01,gapB,mul){\n",
              "  const{F,dt,nflux,bmean,en,floor,med,N,HOP,sr,ae}=ft,tOf=f=>(f*HOP+N/2)/sr,w2=Math.round(.05/dt),lw=Math.round(.6/dt),minImp=.6+imp01*1.6;\n",
              "  // sample-accurate attack time: find the rising edge of the waveform envelope just before the detected flux peak\n",
              "  const refine=tc=>{const i0=Math.max(1,Math.round((tc-.055)*sr)),i1=Math.min(ae.length-1,Math.round((tc+.02)*sr));\n",
              "    if(i1-i0<8)return null;let pk=i0,mx=0;for(let i=i0;i<=i1;i++)if(ae[i]>mx){mx=ae[i];pk=i;}\n",
              "    let base=mx;for(let i=i0;i<=pk;i++)if(ae[i]<base)base=ae[i];\n",
              "    if(mx-base<1e-4||mx<2*base)return null;\n",
              "    const thr=base+.2*(mx-base);let i=pk;while(i>i0&&ae[i-1]>=thr)i--;\n",
              "    return i<=i0+1?null:i/sr;};\n",
              "  // 1. onset events: loudness-weighted flux peaks, importance = size relative to the whole song\n",
              "  const raw=new Float32Array(F),env=new Float32Array(F);\n",
              "  for(let b=0;b<4;b++)for(let f=0;f<F;f++)raw[f]+=nflux[b][f]*.25;\n",
              "  for(let f=1;f<F-1;f++)env[f]=(raw[f-1]+2*raw[f]+raw[f+1])/4;\n",
              "  const pre=new Float64Array(F+1);for(let f=0;f<F;f++)pre[f+1]=pre[f]+env[f];\n",
              "  const ev=[];\n",
              "  for(let f=2;f<F-2;f++){\n",
              "    const lo=Math.max(0,f-lw),hi=Math.min(F,f+lw+1),thr=Math.max((pre[hi]-pre[lo])/(hi-lo)*1.1+.2,minImp);\n",
              "    if(env[f]<thr||env[f]<env[f-1]||env[f]<=env[f+1])continue;\n",
              "    let ok=true;for(let j=Math.max(0,f-w2);j<=Math.min(F-1,f+w2);j++)if(env[j]>env[f]){ok=false;break;}\n",
              "    if(!ok)continue;\n",
              "    const rel=b=>Math.max(nflux[b][f-1],nflux[b][f],nflux[b][f+1])/bmean[b];\n",
              "    const ranks=[0,1,2,3].sort((x,y)=>rel(y)-rel(x));\n",
              "    let s=f;for(let j=f-1;j>=Math.max(1,f-6);j--){if(env[j]>=env[f]*.35)s=j;else break;}\n",
              "    ev.push({f,t:Math.max(0,refine(tOf(f))??(tOf(s)+LEAD)),imp:env[f],lane:ranks[0],dur:0,ranks});\n",
              "  }\n",
              "  // 2. beat grid, measured from the events themselves and tracked locally (±4 s), so a slightly wrong BPM or a drifting\n",
              "  //    band can't drag notes off the music. Phase comes from a weighted circular mean of event times at the beat (h=1)\n",
              "  //    and 16th (h=4) periods; R is how well events really sit on that grid (≈0 for random timing).\n",
              "  const n=ev.length,TW=2*Math.PI;\n",
              "  // local (4 s block) coherence of events with a period, so tempo drift can't hide real alignment\n",
              "  const cohB=(p,h)=>{let tot=0,wt=0;for(let i=0;i<n;){let j=i;while(j<n&&ev[j].t<ev[i].t+4)j++;\n",
              "    if(j-i>=8){let c=0,s=0,w=0;for(let k=i;k<j;k++){const e=ev[k],a=TW*h*e.t/p;c+=e.imp*Math.cos(a);s+=e.imp*Math.sin(a);w+=e.imp;}tot+=Math.hypot(c,s);wt+=w;}i=j;}return wt?tot/wt:0;};\n",
              "  // breakcore / fast breaks: if the tempo was found at half speed (events also sit on the in-between beats), double it\n",
              "  let per=60/(ft.bpm*(mul||1)),half=false;\n",
              "  if(!mul||mul===1)if(n>40&&ft.bpm*2<=240){const c1=cohB(per,4),c2=cohB(per/2,4);if(c1<.5&&c2>c1+.15){per/=2;half=true;}}\n",
              "  const g4=per/4,TOL=Math.min(.03,g4*.2);\n",
              "  const mk=h=>{const c=new Float64Array(n+1),s=new Float64Array(n+1),w=new Float64Array(n+1);\n",
              "    ev.forEach((e,i)=>{const a=TW*h*e.t/per;c[i+1]=c[i]+e.imp*Math.cos(a);s[i+1]=s[i]+e.imp*Math.sin(a);w[i+1]=w[i]+e.imp;});return{c,s,w};};\n",
              "  const P1=mk(1),P4=mk(4),loc=(P,i,j)=>{const c=P.c[j]-P.c[i],s=P.s[j]-P.s[i],w=P.w[j]-P.w[i]||1e-9;return{R:Math.hypot(c,s)/w,ph:Math.atan2(s,c)/TW};};\n",
              "  let lo=0,hi=0,okN=0;\n",
              "  for(let i=0;i<n;i++){const e=ev[i];while(ev[lo].t<e.t-4)lo++;while(hi<n&&ev[hi].t<=e.t+4)hi++;\n",
              "    if(hi-lo<8)continue;const a=loc(P4,lo,hi);if(a.R<.4)continue;\n",
              "    const b=loc(P1,lo,hi),p4=a.ph*g4,k=Math.round((e.t-p4)/g4),kb=Math.round((b.ph*per-p4)/g4);\n",
              "    e.grid=true;e.q=p4+k*g4;e.err=e.t-e.q;e.sub=(((k-kb)%4)+4)%4;okN++;}\n",
              "  const useGrid=n>0&&okN>n*.5,g1=n?loc(P1,0,n):{ph:0},off=((g1.ph*per)%per+per)%per;\n",
              "  // exact tempo + phase: weighted line fit through on-beat events (beat index → time), so the displayed grid cannot drift\n",
              "  let bpmOut=60/per,offOut=off;\n",
              "  if(useGrid){const pts=ev.filter(e=>e.grid&&e.sub===0&&Math.abs(e.err)<TOL*1.5);\n",
              "    if(pts.length>=16){let P=per,O=off;\n",
              "      for(let it=0;it<3;it++){let sw=0,sx=0,sy=0,sxx=0,sxy=0;\n",
              "        for(const e of pts){const m=Math.round((e.q-O)/P),w=e.imp;sw+=w;sx+=w*m;sy+=w*e.t;sxx+=w*m*m;sxy+=w*m*e.t;}\n",
              "        const d=sw*sxx-sx*sx;if(d<=0)break;const s=(sw*sxy-sx*sy)/d,i0=(sy-s*sx)/sw;\n",
              "        if(Math.abs(s/per-1)>.01)break;P=s;O=i0;}\n",
              "      bpmOut=60/P;offOut=((O%P)+P)%P;}}\n",
              "  const cand=[];\n",
              "  for(const e of ev){\n",
              "    e.score=e.imp;\n",
              "    if(e.grid){e.score=e.imp*(e.sub===0?1.35:e.sub===2?1.1:.85);\n",
              "      if(Math.abs(e.err)<TOL){e.t=round3(e.q);if(e.sub%2&&(diff<.35||e.imp<minImp*1.1))continue;}   // snap only when really close\n",
              "      else if(e.imp<minImp*1.1)continue;}\n",
              "    cand.push(e);\n",
              "  }\n",
              "  // 3. holds (unchanged)\n",
              "  if(holdsOn)for(const e of cand){\n",
              "    if(e.imp<minImp)continue;const a=e.f+4;if(a+8>=F||e.f<10)continue;let best=0,bl=e.lane;\n",
              "    for(let b=0;b<4;b++){\n",
              "      let e0=0,pr=0;for(let j=a;j<a+4;j++)e0+=en[b][j];e0/=4;for(let j=e.f-8;j<e.f-2;j++)pr+=en[b][j];pr/=6;\n",
              "      if(e0-floor[b]<1.5*(med[b]-floor[b])||e0-pr<.5*(e0-floor[b]))continue;\n",
              "      const lim=floor[b]+.65*(e0-floor[b]);let f2=a+4;\n",
              "      while(f2<F-1&&(f2-e.f)*dt<2.4&&en[b][f2]>lim&&nflux[b][f2]<10)f2++;\n",
              "      const d=(f2-e.f)*dt;if(d>best){best=d;bl=b;}\n",
              "    }\n",
              "    if(best>=.8){e.dur=best;e.lane=bl;}\n",
              "  }\n",
              "  // 4. spacing (unchanged)\n",
              "  cand.sort((a,b)=>b.score-a.score);\n",
              "  // dense material (short typical gap between onsets) gets proportionally smaller spacing limits\n",
              "  const gp=[];for(let i=1;i<n;i++)gp.push(ev[i].t-ev[i-1].t);gp.sort((a,b)=>a-b);const sc=Math.max(.45,Math.min(1,(gp[gp.length>>1]||.2)/.2));\n",
              "  const acc=[],gL=Math.max((useGrid?per*(.8-.55*diff):.4-.22*diff)*sc,per*(gapB||0)),gA=Math.max((useGrid?per*(.32-.22*diff):.2-.08*diff)*sc,per*(gapB||0));\n",
              "  for(const c of cand){\n",
              "    if(acc.some(a=>a.lane===c.lane&&c.t<a.t+a.dur+gL&&a.t<c.t+c.dur+gL))continue;\n",
              "    const near=acc.filter(a=>Math.abs(a.t-c.t)<gA);\n",
              "    if(near.length&&(diff<.6||near.length>1||near.some(a=>Math.abs(a.t-c.t)>.045)))continue;\n",
              "    acc.push(c);\n",
              "  }\n",
              "  acc.sort((a,b)=>a.t-b.t);let lastH=-9;\n",
              "  for(const a of acc)if(a.dur){if(a.t<lastH+1.5)a.dur=0;else lastH=a.t+a.dur;}\n",
              "  // 5. variety (unchanged)\n",
              "  const rng=mulberry(1234567),cnt=[0,0,0,0],rec=[];\n",
              "  for(const n of acc){\n",
              "    if(!n.dur&&variety>0){\n",
              "      const tot=cnt[0]+cnt[1]+cnt[2]+cnt[3]+1;let bl=n.lane,bs=-9;\n",
              "      n.ranks.forEach((l,i)=>{\n",
              "        if(acc.some(a=>a!==n&&a.lane===l&&(a.dur?(n.t>a.t-.15&&n.t<a.t+a.dur+.15):Math.abs(a.t-n.t)<.12)))return;\n",
              "        const sc=-i*(1.6-1.3*variety)-(rec.slice(-2).includes(l)?2.2*variety:0)-cnt[l]/tot*4*variety+rng()*.8*variety;\n",
              "        if(sc>bs){bs=sc;bl=l;}});\n",
              "      n.lane=bl;\n",
              "    }\n",
              "    cnt[n.lane]++;rec.push(n.lane);\n",
              "  }\n",
              "  const notes=acc.map(c=>({t:round3(c.t),lane:c.lane,type:c.dur?\"hold\":\"tap\",duration:c.dur?round3(c.dur):0})).filter(n=>n.t>.3);\n",
              "  return{bpm:round3(bpmOut),offset:round3(offOut),grid:useGrid,notes,diag:{half,sc,okN,n}};\n",
              "}\n",
              "\n",
              "/* ---------- File + transport ---------- */\n",
              "function refreshUI(){$(\"playBtn\").disabled=!(buf&&chart);$(\"editBtn\").disabled=!chart;$(\"exportBtn\").disabled=!chart;}\n",
              "function setChart(c){chart=c;ns=[];off0=0;result=null;refreshUI();}\n",
              "function regen(){try{\n",
              "  const mul=+$(\"oct\").value||1,d=$(\"difficulty\").value/100,hd=$(\"holds\").checked,v=$(\"variety\").value/100;let imp=$(\"minimp\").value/100,c=build(feat,d,hd,v,imp,0,mul),relaxed=false;\n",
              "  const need=Math.floor((buf?buf.duration:60)*1.2);   // safety net: aim for a comfortably dense chart\n",
              "  let guard=0;\n",
              "  while(c.notes.length<need&&imp>0&&guard++<8){imp=Math.max(0,imp-.2);c=build(feat,d,hd,v,imp,0,mul);relaxed=true;}\n",
              "  if(relaxed)$(\"minimp\").value=Math.round(imp*100);\n",
              "  setChart(c);setStatus(`完成:${c.notes.length} 个音符(${c.notes.filter(n=>n.type===\"hold\").length} 长条)· BPM ${c.bpm}${c.grid?\"\":\"(节拍不稳,未对齐网格)\"}${relaxed?\" · 音符偏少,已自动降低重要度\":\"\"}`);\n",
              "}catch(err){console.error(err);setStatus(\"生成失败:\"+(err&&err.message||err));}}\n",
              "$(\"audioFile\").addEventListener(\"change\",async e=>{const f=e.target.files[0];if(!f)return;songTok++;$(\"songSel\").value=\"\";$(\"oct\").value=\"1\";setStatus(\"解码音频中…\");stopAudio();\n",
              "  try{await AC.resume();buf=await AC.decodeAudioData(await f.arrayBuffer());feat=null;chart=null;ns=[];off0=0;result=null;refreshUI();$(\"analyzeBtn\").disabled=false;setStatus(`已加载:${f.name}(${buf.duration.toFixed(1)} 秒)。点击“识别并生成”。`);}\n",
              "  catch(err){setStatus(`无法解码 ${f.name}:浏览器不支持该格式。请改用 MP3 / WAV / OGG / M4A。`);}});\n",
              "$(\"chartFile\").addEventListener(\"change\",async e=>{const f=e.target.files[0];if(!f)return;\n",
              "  try{const j=JSON.parse(await f.text());setChart({bpm:j.bpm||120,offset:j.offset||0,grid:!!j.grid,notes:j.notes.map(n=>({t:n.t||0,lane:n.lane||0,type:n.type||\"tap\",duration:n.duration||0})).sort((a,b)=>a.t-b.t)});setStatus(`导入完成:${chart.notes.length} 个音符。`);}\n",
              "  catch(err){setStatus(\"谱面文件无效。\");}});\n",
              "$(\"analyzeBtn\").addEventListener(\"click\",async()=>{if(!buf)return;$(\"analyzeBtn\").disabled=true;stopAudio();\n",
              "  try{if(!feat)feat=await extract(buf);if(!feat)setStatus(\"音频太短,无法分析。\");else regen();}catch(err){console.error(err);setStatus(\"生成失败:\"+(err&&err.message||err));}\n",
              "  $(\"analyzeBtn\").disabled=false;});\n",
              "$(\"oct\").addEventListener(\"change\",()=>{if(feat&&!playing)regen();});\n",
              "$(\"difficulty\").addEventListener(\"change\",()=>{if(feat&&!playing)regen();});\n",
              "[\"holds\",\"variety\",\"minimp\"].forEach(id=>$(id).addEventListener(\"change\",()=>{if(feat&&!playing)regen();}));   // re-pick instantly, no re-analysis\n",
              "let dl=null;\n",
              "(async()=>{try{dl=window.claude&&await claude.use(\"downloads\");}catch(e){dl=null;}})();\n",
              "$(\"exportBtn\").addEventListener(\"click\",async()=>{if(!chart)return;const json=JSON.stringify(chart,null,2);\n",
              "  if(dl){try{await dl.save({filename:\"chart.json\",data:json});}catch(err){if(!err||err.code!==\"declined\")setStatus(\"导出失败,请重试。\");}return;}\n",
              "  const a=document.createElement(\"a\");a.href=URL.createObjectURL(new Blob([json],{type:\"application/json\"}));a.download=\"chart.json\";document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),1000);});\n",
              "$(\"editBtn\").addEventListener(\"click\",()=>{editing=!editing;if(editing)stopAudio();ns=[];$(\"editBtn\").textContent=`编辑:${editing?\"开\":\"关\"}`;});\n",
              "\n",
              "const pos=()=>playing?off0+AC.currentTime-t0:off0;\n",
              "const vis=()=>pos()-outLat()+$(\"av\").value/1000;   // what is drawn: lines up with what you HEAR\n",
              "const now=()=>vis()+$(\"sync\").value/1000;          // what is judged: also compensates your own tap delay\n",
              "let tickTimer=null,tickI=0,tickBus=null;\n",
              "function startTicks(){clearInterval(tickTimer);tickBus=null;}   // metronome clicks removed\n",
              "function stopAudio(){if(playing)off0=Math.max(0,off0+AC.currentTime-t0);clearInterval(tickTimer);if(tickBus){try{tickBus.disconnect();}catch(e){}tickBus=null;}const s=src;src=null;if(s){try{s.stop();}catch(e){}}playing=false;active=[false,false,false,false];touches.clear();$(\"playBtn\").textContent=\"▶ 播放 / 暂停\";}\n",
              "function playFrom(o){stopAudio();if(!buf||!chart)return;off0=Math.max(0,o);result=null;\n",
              "  if(!ns.length||off0===0){ns=chart.notes.map(n=>({...n,hit:false,missed:false,holding:false,done:false,broken:false}));score=combo=maxCombo=0;counts={P:0,G:0,O:0,M:0};parts=[];rings=[]}\n",
              "  const s=AC.createBufferSource();s.buffer=buf;s.connect(analyser);const st=AC.currentTime+.06;s.start(st,off0);src=s;t0=st;playing=true;startTicks();$(\"playBtn\").textContent=\"⏸ 暂停\";\n",
              "  s.onended=()=>{if(src===s&&playing){stopAudio();finish();}};}\n",
              "function finish(){const T=ns.length;if(!T||editing)return;const a=(counts.P+counts.G*.8+counts.O*.5)/T;result={a,rank:a>=.95?\"S\":a>=.9?\"A\":a>=.8?\"B\":a>=.65?\"C\":\"D\"};off0=0;}\n",
              "$(\"playBtn\").addEventListener(\"click\",async()=>{await AC.resume();if(playing)stopAudio();else playFrom(off0);});\n",
              "\n",
              "/* ---------- Fruit fly player ---------- */\n",
              "// A small spiking \"fly brain\" (leaky integrate-and-fire reservoir) plays the chart. Same recipe as the fly_learns notebook:\n",
              "// fixed random recurrent wiring W0, a fast linear readout w_fast trained online (normalised LMS), and reward-modulated\n",
              "// plasticity on the recurrent synapses (eligibility = pre*post activity, decay back to W0, clipped).\n",
              "const Fly=(()=>{\n",
              "  const N=160,L=4,CT=[-.06,-.03,0,.03,.06,.1,.15,.22,.3,.4],K=CT.length,NIN=L*K,P_REC=.08,P_IN=.3;\n",
              "  const LR_READOUT=.015,WD_READOUT=1e-4,LR_SYN=.004,W_DECAY=.01,W_CLIP=4,POS_W=6;\n",
              "  const rnd=mulberry(20261020),SIG=.02;\n",
              "  const pre=[],post=[],w0=[];\n",
              "  for(let i=0;i<N;i++)for(let j=0;j<N;j++)if(i!==j&&rnd()<P_REC){pre.push(i);post.push(j);w0.push(rnd()<.8?.05+.06*rnd():-(.1+.1*rnd()));}\n",
              "  const S=pre.length,PRE=Int16Array.from(pre),POST=Int16Array.from(post),W0=Float32Array.from(w0);\n",
              "  const win=new Float32Array(N*NIN);for(let j=0;j<N;j++)for(let k=0;k<NIN;k++)if(rnd()<P_IN)win[j*NIN+k]=(rnd()<.85?1:-1)*(.12+.3*rnd());\n",
              "  const th=Float32Array.from({length:N},()=>1+.35*rnd());\n",
              "  const f={N,S,W:new Float32Array(W0),wf:[0,1,2,3].map(()=>new Float32Array(N+1)),seen:0,hits:0,miss:0,acc:0,frames:0,\n",
              "    v:new Float32Array(N),s:new Float32Array(N),x:new Float32Array(N+1),el:new Float32Array(S),u:new Float32Array(NIN),y:[0,0,0,0]};\n",
              "  f.x[N]=1;\n",
              "  f.step=(dt,tau,learn)=>{\n",
              "    const{v,s,x,u,W,el}=f,a=Math.exp(-dt/.04),b=Math.exp(-dt/.05),e=Math.exp(-dt/.3);\n",
              "    for(let l=0;l<L;l++){const t=tau[l];for(let k=0;k<K;k++)u[l*K+k]=t===null?0:Math.exp(-.5*((t-CT[k])/SIG)**2);}\n",
              "    const rec=new Float32Array(N);for(let q=0;q<S;q++)if(s[PRE[q]])rec[POST[q]]+=W[q];\n",
              "    for(let j=0;j<N;j++){let I=0;const o=j*NIN;for(let k=0;k<NIN;k++)if(u[k]>.01)I+=win[o+k]*u[k];\n",
              "      let vj=v[j]*a+I+rec[j]+.04*(Math.random()+Math.random()-1);\n",
              "      if(vj>th[j]){s[j]=1;vj=0;}else s[j]=0;v[j]=vj;x[j]=x[j]*b+s[j]*(1-b);}\n",
              "    for(let q=0;q<S;q++)el[q]=el[q]*e+x[PRE[q]]*x[POST[q]];\n",
              "    let xx=1e-6;for(let j=0;j<=N;j++)xx+=x[j]*x[j];\n",
              "    for(let l=0;l<L;l++){const w=f.wf[l];let y=0;for(let j=0;j<=N;j++)y+=w[j]*x[j];f.y[l]=y;\n",
              "      if(learn){const tg=tau[l]!==null&&Math.abs(tau[l])<.04?1:0,err=tg-y,g=LR_READOUT*err*(tg?POS_W:1)/xx;\n",
              "        for(let j=0;j<=N;j++){w[j]=(1-WD_READOUT)*w[j]+g*x[j];if(w[j]>200)w[j]=200;else if(w[j]<-200)w[j]=-200;}}}\n",
              "    f.frames++;return f.y;};\n",
              "  f.reward=r=>{const{W,el}=f;let m=1e-9;for(let q=0;q<S;q++)if(el[q]>m)m=el[q];\n",
              "    for(let q=0;q<S;q++){const c=Math.abs(W0[q])*W_CLIP+1e-6;let w=W[q]+LR_SYN*r*(el[q]/m)*Math.abs(W0[q])*10-W_DECAY*(W[q]-W0[q]);W[q]=w>c?c:w<-c?-c:w;}};\n",
              "  f.note=(hit,good)=>{f.seen++;if(hit)f.hits++;else f.miss++;f.acc=f.acc*.96+.04*(good);};\n",
              "  f.reset=()=>{f.W.set(W0);f.wf.forEach(w=>w.fill(0));f.seen=f.hits=f.miss=f.acc=f.frames=0;f.v.fill(0);f.s.fill(0);f.x.fill(0);f.x[N]=1;f.el.fill(0);};\n",
              "  f.dump=()=>JSON.stringify({W:Array.from(f.W,v=>+v.toFixed(5)),wf:f.wf.map(w=>Array.from(w,v=>+v.toFixed(4))),seen:f.seen,hits:f.hits,miss:f.miss,acc:f.acc,frames:f.frames});\n",
              "  f.load=str=>{const d=JSON.parse(str);if(d.W.length!==S||d.wf[0].length!==N+1)return false;f.W.set(d.W);d.wf.forEach((w,l)=>f.wf[l].set(w));f.seen=d.seen|0;f.hits=d.hits|0;f.miss=d.miss|0;f.acc=+d.acc||0;f.frames=d.frames|0;return true;};\n",
              "  return f;})();\n",
              "\n",
              "/* ---------- Gameplay ---------- */\n",
              "const bump=()=>{combo++;maxCombo=Math.max(maxCombo,combo);cs=1.1;};\n",
              "function fx(l,perfect){const{cx,hitY,hw}=geom(),x=cx+(l-1.5)*hw/2,c=perfect?\"255,255,255\":RGB[l];flash[l]=1;\n",
              "  for(let i=0;i<7;i++)parts.push({x,y:hitY,vx:(Math.random()-.5)*14,vy:-Math.random()*9-1,l:1,d:.03+Math.random()*.04,c,w:1+Math.random()*3});\n",
              "  rings.push({x,y:hitY,r:8,l:1,c});}\n",
              "function press(l){if(!playing||editing)return;const ct=now();let b=null;\n",
              "  for(const n of ns){if(n.t>ct+.25)break;if(n.lane===l&&!n.hit&&!n.missed&&n.t>=ct-.25){b=n;break;}}\n",
              "  if(!b)return;const d=Math.abs(b.t-ct),k=d<.09?\"P\":d<.16?\"G\":\"O\";\n",
              "  b.hit=true;if(b.type===\"hold\")b.holding=true;counts[k]++;\n",
              "  judge={t:{P:\"PERFECT\",G:\"GREAT\",O:\"GOOD\"}[k],at:performance.now(),k};\n",
              "  score+={P:300,G:200,O:100}[k]+Math.min(combo,50)*2;bump();fx(l,k===\"P\");}\n",
              "function release(l){if(!playing||editing)return;const ct=now();\n",
              "  for(const n of ns)if(n.lane===l&&n.holding){n.holding=false;\n",
              "    if(ct>=n.t+n.duration-.3){n.done=true;score+=150;bump();fx(l,true);}\n",
              "    else{n.broken=true;combo=0;judge={t:\"BREAK\",at:performance.now(),k:\"M\"};}}}\n",
              "addEventListener(\"keydown\",e=>{if(e.repeat)return;if(cal){if(e.key===\"Escape\"){cal=null;setStatus(\"已取消校准。\");}else calTap();e.preventDefault();return;}const k=e.key.toLowerCase();\n",
              "  if(editing){\n",
              "    if(\"1234\".includes(k)&&k)selLane=+k-1;\n",
              "    if((k===\"a\"||k===\"h\")&&chart){chart.notes.push({t:round3(vis()),lane:selLane,type:k===\"a\"?\"tap\":\"hold\",duration:k===\"a\"?0:.5});chart.notes.sort((a,b)=>a.t-b.t);ns=[];}\n",
              "    if(k===\"x\"&&chart){const ct=vis(),d=chart.notes.slice().sort((a,b)=>Math.abs(a.t-ct)-Math.abs(b.t-ct))[0];if(d){chart.notes=chart.notes.filter(n=>n!==d);ns=[];}}\n",
              "    if(k===\" \"){e.preventDefault();AC.resume();playing?stopAudio():playFrom(off0);}\n",
              "    if(k===\"arrowleft\"&&!playing)off0=Math.max(0,off0-.1);\n",
              "    if(k===\"arrowright\"&&!playing)off0+=.1;\n",
              "    return;}\n",
              "  const l=KEYS.indexOf(k);if(l>=0&&!active[l]){active[l]=true;AC.resume();press(l);}});\n",
              "addEventListener(\"keyup\",e=>{const l=KEYS.indexOf(e.key.toLowerCase());if(l>=0&&!editing){active[l]=false;release(l);}});\n",
              "const laneAt=x=>{const{cx,hw}=geom();return Math.max(0,Math.min(3,Math.floor((x-(cx-hw))/(hw/2))));};\n",
              "cv.addEventListener(\"pointerdown\",e=>{e.preventDefault();AC.resume();if(cal){calTap();return;}cv.setPointerCapture(e.pointerId);\n",
              "  const l=laneAt(e.clientX-cv.getBoundingClientRect().left);touches.set(e.pointerId,l);\n",
              "  if(editing)selLane=l;else if(!active[l]){active[l]=true;press(l);}});\n",
              "const up=e=>{if(!touches.has(e.pointerId))return;const l=touches.get(e.pointerId);touches.delete(e.pointerId);\n",
              "  if(!editing&&![...touches.values()].includes(l)){active[l]=false;release(l);}};\n",
              "cv.addEventListener(\"pointerup\",up);cv.addEventListener(\"pointercancel\",up);\n",
              "\n",
              "/* ---------- Tap-sync calibration ---------- */\n",
              "let cal=null;\n",
              "const outLat=()=>AC.outputLatency||AC.baseLatency||0;\n",
              "async function startCal(){await AC.resume();stopAudio();editing=false;$(\"editBtn\").textContent=\"编辑:关\";$(\"calBtn\").blur();\n",
              "  const st=AC.currentTime+1.2,beeps=[];\n",
              "  for(let i=0;i<12;i++){const T=st+i*.75;beeps.push(T);const o=AC.createOscillator(),v=AC.createGain();o.frequency.value=1000;\n",
              "    v.gain.setValueAtTime(0,T);v.gain.linearRampToValueAtTime(.5,T+.003);v.gain.exponentialRampToValueAtTime(.001,T+.07);\n",
              "    o.connect(v);v.connect(AC.destination);o.start(T);o.stop(T+.1);}\n",
              "  cal={beeps,d:{}};setStatus(\"校准中:听到“嘀”声的瞬间点击(前两声用来热身)。\");}\n",
              "function calTap(){const t=AC.currentTime-outLat();let bi=0,bd=9;\n",
              "  cal.beeps.forEach((T,i)=>{const d=Math.abs(t-T);if(d<bd){bd=d;bi=i;}});\n",
              "  if(bi>=2&&bd<.375)cal.d[bi]=t-cal.beeps[bi];}\n",
              "function finishCal(){const v=Object.values(cal.d).sort((a,b)=>a-b);cal=null;\n",
              "  if(v.length<4){setStatus(\"点击次数太少,请重试校准。\");return;}\n",
              "  const ms=Math.max(-300,Math.min(300,Math.round(-v[v.length>>1]*1000))),sp=Math.round((v[v.length-1]-v[0])*1000);\n",
              "  $(\"sync\").value=ms;\n",
              "  setStatus(`校准完成:同步 ${ms} ms(${v.length} 次点击,波动 ${sp} ms)${sp>150?\" — 波动较大,建议重试\":\"\"}。`);}\n",
              "function drawCal(){const{cx,hy,hitY}=geom(),cy=(hy+hitY)/2,t=AC.currentTime-outLat();\n",
              "  if(t>cal.beeps[11]+.6){finishCal();return;}\n",
              "  let age=9;for(const T of cal.beeps)if(t>=T&&t-T<age)age=t-T;\n",
              "  const f=Math.max(0,1-age/.25);\n",
              "  g.fillStyle=`rgba(127,168,201,${.12+.45*f})`;g.beginPath();g.arc(cx,cy,50+40*f,0,6.283);g.fill();\n",
              "  g.strokeStyle=\"#fff\";g.lineWidth=3;g.beginPath();g.arc(cx,cy,50,0,6.283);g.stroke();\n",
              "  g.textAlign=\"center\";g.fillStyle=\"#fff\";g.font=FONT(\"700 22px\");g.fillText(\"听到“嘀”声的瞬间,点击任意键或屏幕\",cx,cy-110);\n",
              "  g.fillStyle=\"#9fb0e0\";g.font=FONT(\"500 15px\");g.fillText(`已记录 ${Object.keys(cal.d).length} 次 · Esc 取消`,cx,cy+120);}\n",
              "$(\"calBtn\").addEventListener(\"click\",startCal);\n",
              "$(\"av\").addEventListener(\"input\",()=>$(\"avv\").textContent=$(\"av\").value);\n",
              "\n",
              "/* ---------- Fruit fly control ---------- */\n",
              "const FKEY=\"loombeat.fly.v1\";let flyLast=performance.now(),flyRel=[0,0,0,0],flyCool=[0,0,0,0],flyWas=false,flySnap={P:0,G:0,O:0,M:0},flySave=0,flyTxt=0;\n",
              "try{const sv=localStorage.getItem(FKEY);if(sv)Fly.load(sv);}catch(e){}\n",
              "function flySaveNow(){try{localStorage.setItem(FKEY,Fly.dump());}catch(e){}}\n",
              "function flyShow(){$(\"flyStat\").textContent=$(\"flyOn\").checked?`果蝇经验 ${Fly.seen} 音符 · 近期命中率 ${Math.round(Fly.acc*100)}%`:(Fly.seen?`果蝇经验 ${Fly.seen} 音符`:\"\");}\n",
              "function flyTick(){\n",
              "  const t=performance.now(),dt=Math.min(.034,Math.max(.004,(t-flyLast)/1000));flyLast=t;\n",
              "  const on=$(\"flyOn\").checked&&playing&&!editing&&!cal&&ns.length>0;\n",
              "  if(!on){if(flyWas){for(let l=0;l<4;l++)if(flyRel[l]){flyRel[l]=0;active[l]=false;release(l);}flyWas=false;flySaveNow();}return;}\n",
              "  if(!flyWas){flyWas=true;flySnap={...counts};}\n",
              "  const jt=now(),tau=[null,null,null,null];\n",
              "  for(const n of ns){const d=n.t-jt;if(d>.45)break;if(d<-.1||n.missed||n.hit)continue;if(tau[n.lane]===null||Math.abs(d)<Math.abs(tau[n.lane]))tau[n.lane]=d;}\n",
              "  const y=Fly.step(dt,tau,true);\n",
              "  for(let l=0;l<4;l++){flyCool[l]-=dt;\n",
              "    if(flyRel[l]&&jt>=flyRel[l]){flyRel[l]=0;active[l]=false;release(l);}\n",
              "    if(y[l]>.5&&flyCool[l]<=0&&!active[l]){active[l]=true;flyCool[l]=.09;press(l);\n",
              "      const h=ns.find(n=>n.lane===l&&n.holding);flyRel[l]=h?h.t+h.duration-.03:jt+.06;}}\n",
              "  const dP=counts.P-flySnap.P,dG=counts.G-flySnap.G,dO=counts.O-flySnap.O,dM=counts.M-flySnap.M;\n",
              "  if(dP<0||dG<0||dO<0||dM<0)flySnap={...counts};\n",
              "  else if(dP+dG+dO+dM){flySnap={...counts};Fly.reward(dP+.6*dG+.2*dO-dM);\n",
              "    for(let i=0;i<dP+dG+dO;i++)Fly.note(true,1);for(let i=0;i<dM;i++)Fly.note(false,0);}\n",
              "  if(t-flyTxt>400){flyTxt=t;flyShow();}if(t-flySave>5000){flySave=t;flySaveNow();}\n",
              "}\n",
              "$(\"flyOn\").addEventListener(\"change\",()=>{flyShow();flySaveNow();$(\"flyOn\").blur();});\n",
              "$(\"flyReset\").addEventListener(\"click\",()=>{Fly.reset();flySaveNow();flyShow();$(\"flyReset\").blur();});\n",
              "addEventListener(\"pagehide\",flySaveNow);flyShow();\n",
              "\n",
              "/* ---------- Render ---------- */\n",
              "function draw(){\n",
              "  requestAnimationFrame(draw);if(!W)return;\n",
              "  const{cx,hy,hitY,hw}=geom(),ct=vis(),jt=now(),win=1260/$(\"speed\").value,sH=1/(1+Z);\n",
              "  const P=z=>{const s=1/(1+z*Z);return{s,y:hy+(hitY-hy)*s};},X=(l,s)=>cx+(l-1.5)*(hw/2)*s;\n",
              "  analyser.getByteFrequencyData(fdata);flyTick();\n",
              "  let bs=0;for(let i=1;i<6;i++)bs+=fdata[i];bs/=1275;pulse+=(bs-pulse)*(bs>pulse?.5:.1);\n",
              "\n",
              "  // sky + horizon glow + spectrum skyline\n",
              "  let gr=g.createLinearGradient(0,0,0,H);gr.addColorStop(0,\"#04050c\");gr.addColorStop(hy/H,\"#0a0e1c\");gr.addColorStop(1,\"#05060d\");g.fillStyle=gr;g.fillRect(0,0,W,H);\n",
              "  gr=g.createRadialGradient(cx,hy,0,cx,hy,W*.55);gr.addColorStop(0,`rgba(70,95,170,${.08+pulse*.18})`);gr.addColorStop(1,\"rgba(90,130,255,0)\");g.fillStyle=gr;g.fillRect(0,0,W,H);\n",
              "  const nb=56,bw=W/nb;\n",
              "  for(let i=0;i<nb;i++){const v=fdata[1+Math.floor(Math.pow(i/nb,1.5)*90)]/255,bh=2+v*hy*.45;\n",
              "    g.fillStyle=`rgba(110,135,190,${.14+v*.25})`;g.fillRect(i*bw+1,hy-bh,bw-2,bh);g.fillStyle=\"rgba(110,135,190,.06)\";g.fillRect(i*bw+1,hy,bw-2,bh*.45);}\n",
              "  g.globalAlpha=1;\n",
              "\n",
              "  // highway\n",
              "  const hh=hw*sH,eb=hh+(hw-hh)*(H-hy)/(hitY-hy);\n",
              "  gr=g.createLinearGradient(0,hy,0,H);gr.addColorStop(0,\"rgba(9,12,24,.95)\");gr.addColorStop(1,\"rgba(12,14,28,.97)\");\n",
              "  g.fillStyle=gr;g.beginPath();g.moveTo(cx-hh,hy);g.lineTo(cx+hh,hy);g.lineTo(cx+eb,H);g.lineTo(cx-eb,H);g.closePath();g.fill();\n",
              "  g.save();g.shadowColor=\"#4d6db0\";g.shadowBlur=4+pulse*8;g.strokeStyle=`rgba(150,180,235,${.3+pulse*.2})`;g.lineWidth=2;\n",
              "  for(const sg of[-1,1]){g.beginPath();g.moveTo(cx+sg*hh,hy);g.lineTo(cx+sg*eb,H);g.stroke();}g.restore();\n",
              "  g.strokeStyle=\"rgba(255,255,255,.08)\";g.lineWidth=1;\n",
              "  for(let i=1;i<4;i++){const u=(i-2)/2;g.beginPath();g.moveTo(cx+u*hh,hy);g.lineTo(cx+u*eb,H);g.stroke();}\n",
              "\n",
              "  if(cal){drawCal();return;}\n",
              "  if(!chart){g.fillStyle=\"#9fb0e0\";g.textAlign=\"center\";g.font=FONT(\"700 20px\");g.fillText(\"上传音频,点击“识别并生成”\",cx,hy+(hitY-hy)*.5);return;}\n",
              "\n",
              "  // beat grid (also a visual check that the detected tempo matches the song)\n",
              "  if(chart.grid){const per=60/chart.bpm;let k=Math.ceil((ct-.05-chart.offset)/per);\n",
              "    for(let c=0;c<64;c++,k++){const z=(chart.offset+k*per-ct)/win;if(z>1)break;const p=P(z),m=k%4===0;\n",
              "      g.strokeStyle=`rgba(190,210,255,${(m?.35:.13)*(1-z)})`;g.lineWidth=(m?2:1)*p.s+.5;g.beginPath();g.moveTo(cx-hw*p.s,p.y);g.lineTo(cx+hw*p.s,p.y);g.stroke();}}\n",
              "\n",
              "  // lane beams, hit line, receptors\n",
              "  for(let l=0;l<4;l++){flash[l]*=.9;const a=Math.max(active[l]&&!editing?.55:0,flash[l]*.6);if(a<.02)continue;\n",
              "    gr=g.createLinearGradient(0,hitY,0,hy+(hitY-hy)*.2);gr.addColorStop(0,`rgba(${RGB[l]},${a})`);gr.addColorStop(1,`rgba(${RGB[l]},0)`);g.fillStyle=gr;\n",
              "    g.beginPath();g.moveTo(X(l-.5,1),hitY);g.lineTo(X(l+.5,1),hitY);g.lineTo(X(l+.5,sH),hy);g.lineTo(X(l-.5,sH),hy);g.fill();}\n",
              "  g.fillStyle=\"rgba(255,255,255,.7)\";g.fillRect(cx-hw,hitY-1.5,2*hw,3);\n",
              "  g.textAlign=\"center\";\n",
              "  for(let l=0;l<4;l++){const w=hw/2*.86,on=active[l]&&!editing;g.save();g.shadowColor=COL[l];g.shadowBlur=5;g.strokeStyle=on?\"#fff\":COL[l];g.lineWidth=on?3:2;\n",
              "    rr(X(l,1)-w/2,hitY-9,w,18,9);g.stroke();if(on){g.fillStyle=`rgba(${RGB[l]},.4)`;g.fill();}g.restore();\n",
              "    g.fillStyle=editing&&selLane===l?\"#fff\":COL[l];g.font=FONT(\"700 16px\");g.fillText(KEYS[l].toUpperCase(),X(l,1),hitY+34);}\n",
              "\n",
              "  // miss + hold-completion checks\n",
              "  if(playing&&!editing)for(const n of ns){\n",
              "    if(!n.hit&&!n.missed&&n.t<jt-.25){n.missed=true;combo=0;counts.M++;judge={t:\"MISS\",at:performance.now(),k:\"M\"};}\n",
              "    if(n.holding&&jt>=n.t+n.duration){n.holding=false;n.done=true;score+=150;bump();fx(n.lane,true);}}\n",
              "\n",
              "\n",
              "  // notes, far → near\n",
              "  const list=editing||!ns.length?chart.notes:ns,nw=hw*.2;\n",
              "  for(let i=list.length-1;i>=0;i--){const n=list[i],hold=n.type===\"hold\",d=n.duration||0;\n",
              "    if((n.hit&&!hold)||n.done)continue;\n",
              "    const z=(n.t-ct)/win,zE=(n.t+d-ct)/win;if(zE<-.04||z>1.02)continue;\n",
              "    const h=P(n.holding?0:Math.max(z,-.03)),col=COL[n.lane],rgb=RGB[n.lane];\n",
              "    g.globalAlpha=Math.max(0,(n.missed||n.broken?.3:1)*Math.min(1,(1.02-z)*6));\n",
              "    if(hold){const t=P(Math.min(zE,1)),x1=X(n.lane,h.s),x2=X(n.lane,t.s),b1=nw*.6*h.s,b2=nw*.6*t.s;\n",
              "      gr=g.createLinearGradient(0,t.y,0,h.y);gr.addColorStop(0,`rgba(${rgb},.1)`);gr.addColorStop(1,`rgba(${rgb},${n.holding?.6+.25*Math.sin(performance.now()/60):.42})`);\n",
              "      g.fillStyle=gr;g.beginPath();g.moveTo(x1-b1,h.y);g.lineTo(x1+b1,h.y);g.lineTo(x2+b2,t.y);g.lineTo(x2-b2,t.y);g.closePath();g.fill();\n",
              "      g.strokeStyle=col;g.lineWidth=1.5;g.stroke();g.fillStyle=col;rr(x2-b2*1.5,t.y-3,b2*3,6*t.s+2,3);g.fill();}\n",
              "    const x=X(n.lane,h.s),ww=nw*h.s,hn=13*h.s+3;\n",
              "    g.shadowColor=col;g.shadowBlur=6*h.s;\n",
              "    gr=g.createLinearGradient(0,h.y-hn,0,h.y+hn);gr.addColorStop(0,\"#fff\");gr.addColorStop(.35,col);gr.addColorStop(1,`rgba(${rgb},.55)`);\n",
              "    g.fillStyle=gr;rr(x-ww,h.y-hn,ww*2,hn*2,hn);g.fill();g.shadowBlur=0;g.globalAlpha=1;}\n",
              "\n",
              "  // FX\n",
              "  g.globalCompositeOperation=\"lighter\";\n",
              "  for(let i=rings.length-1;i>=0;i--){const r=rings[i];r.r+=3.4;r.l-=.05;if(r.l<=0){rings.splice(i,1);continue;}\n",
              "    g.strokeStyle=`rgba(${r.c},${r.l})`;g.lineWidth=2*r.l;g.beginPath();g.ellipse(r.x,r.y,r.r,r.r*.35,0,0,6.283);g.stroke();}\n",
              "  g.lineCap=\"round\";\n",
              "  for(let i=parts.length-1;i>=0;i--){const p=parts[i];p.x+=p.vx;p.y+=p.vy;p.vy+=.35;p.l-=p.d;if(p.l<=0){parts.splice(i,1);continue;}\n",
              "    g.strokeStyle=`rgba(${p.c},${p.l})`;g.lineWidth=p.w*p.l;g.beginPath();g.moveTo(p.x,p.y);g.lineTo(p.x-p.vx*1.6,p.y-p.vy*1.6);g.stroke();}\n",
              "  g.globalCompositeOperation=\"source-over\";\n",
              "\n",
              "  // HUD\n",
              "  g.textAlign=\"left\";g.fillStyle=\"#7c88ad\";g.font=FONT(\"500 12px\");g.fillText(\"得分\",16,18);\n",
              "  g.fillStyle=\"#fff\";g.font=FONT(\"700 28px\");g.fillText(String(score).padStart(7,\"0\"),16,46);\n",
              "  const T=counts.P+counts.G+counts.O+counts.M;g.textAlign=\"right\";g.fillStyle=\"#7c88ad\";g.font=FONT(\"500 12px\");g.fillText(\"准确率\",W-16,18);\n",
              "  g.fillStyle=\"#fff\";g.font=FONT(\"700 28px\");g.fillText(T?((counts.P+counts.G*.8+counts.O*.5)/T*100).toFixed(1)+\"%\":\"--\",W-16,46);\n",
              "  if(buf){g.fillStyle=\"#6f9bc4\";g.fillRect(0,0,W*Math.min(1,pos()/buf.duration),2);}\n",
              "  cs+=(1-cs)*.18;\n",
              "  if(combo>1){g.save();g.translate(cx,hy+(hitY-hy)*.3);g.scale(cs,cs);g.textAlign=\"center\";g.font=FONT(\"700 38px\");g.fillStyle=\"rgba(255,255,255,.85)\";\n",
              "    g.shadowColor=combo>=30?\"#7fa8c9\":\"#000\";g.shadowBlur=combo>=30?10:4;g.fillText(combo,0,0);g.shadowBlur=0;g.font=FONT(\"500 14px\");g.fillStyle=\"#9fb0e0\";g.fillText(\"连击\",0,22);g.restore();}\n",
              "  const age=performance.now()-judge.at;\n",
              "  if(age<520&&!editing){const f=1-Math.pow(age/520,2);g.save();g.globalAlpha=f;g.translate(cx,hy+(hitY-hy)*.6);g.scale(1+(1-f)*.4,1+(1-f)*.4);g.textAlign=\"center\";g.font=FONT(\"700 24px\");\n",
              "    g.shadowColor={P:\"#e8dcc0\",G:\"#a8cade\",O:\"#cfd8b8\",M:\"#d8a0aa\"}[judge.k]||\"#fff\";g.shadowBlur=7;g.fillStyle=\"#fff\";g.fillText(judge.t,0,0);g.restore();}\n",
              "\n",
              "  if(editing){g.textAlign=\"left\";g.fillStyle=\"#8fa8c4\";g.font=FONT(\"500 14px\");g.fillText(`编辑 · 时间 ${round3(ct)}s · 轨道 ${selLane+1} · 1-4 选轨 A 单点 H 长条 X 删除 ←→ 微调 空格播放`,16,H-14);}\n",
              "  if(result){g.fillStyle=\"rgba(4,5,12,.78)\";g.fillRect(0,0,W,H);g.textAlign=\"center\";\n",
              "    g.fillStyle=\"#c9a227\";g.font=FONT(\"700 64px\");g.fillText(result.rank,cx,H*.38);\n",
              "    g.fillStyle=\"#fff\";g.font=FONT(\"700 30px\");g.fillText(String(score).padStart(7,\"0\"),cx,H*.38+48);\n",
              "    g.fillStyle=\"#9fb0e0\";g.font=FONT(\"500 16px\");g.fillText(`准确率 ${(result.a*100).toFixed(1)}% · 最高连击 ${maxCombo}`,cx,H*.38+80);\n",
              "    g.fillText(`PERFECT ${counts.P} · GREAT ${counts.G} · GOOD ${counts.O} · MISS ${counts.M}`,cx,H*.38+106);\n",
              "    g.fillText(\"点击“播放”再来一次\",cx,H*.38+140);}\n",
              "}\n",
              "draw();\n",
              "\n",
              "// Built-in song list: each track is decoded and charted when selected (playback starts from the play button)\n",
              "let songTok=0;\n",
              "async function loadSong(i){const tok=++songTok;try{\n",
              "  stopAudio();setStatus(\"加载曲目…\");\n",
              "  const el=$(\"song\"+i),bin=atob(el.textContent.trim()),u=new Uint8Array(bin.length);for(let k=0;k<bin.length;k++)u[k]=bin.charCodeAt(k);\n",
              "  const b=await AC.decodeAudioData(u.buffer);if(tok!==songTok)return;\n",
              "  buf=b;feat=null;chart=null;ns=[];off0=0;result=null;$(\"minimp\").value=45;$(\"oct\").value=el.dataset.oct||\"1\";refreshUI();$(\"analyzeBtn\").disabled=true;\n",
              "  const f=await extract(b);if(tok!==songTok)return;\n",
              "  feat=f;regen();$(\"analyzeBtn\").disabled=false;setStatus(el.dataset.name+\" · \"+$(\"status\").textContent);\n",
              "}catch(err){console.error(err);if(tok===songTok)setStatus(\"曲目加载失败,请手动上传音频。\");}}\n",
              "$(\"songSel\").addEventListener(\"change\",()=>{if($(\"songSel\").value!==\"\")loadSong(+$(\"songSel\").value);});\n",
              "loadSong(0);\n",
              "</script>\n",
              "</body></html>\n"
            ]
          },
          "metadata": {}
        }
      ],
      "source": [
        "%%html\n",
        "<!doctype html>\n",
        "<html lang=\"zh\"><head><meta charset=\"utf-8\">\n",
        "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n",
        "<title>声轨织机 LoomBeat v5</title>\n",
        "<style>\n",
        ":root{color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--ink:#e8eeff;--mute:#7c88ad}\n",
        "html{scroll-padding-top:env(safe-area-inset-top,0px)}\n",
        "html,body{margin:0;height:100%;background:#05060d;color:var(--ink);font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;overflow:hidden;touch-action:none}\n",
        "body{display:flex;flex-direction:column}\n",
        "#bar{display:flex;flex-wrap:wrap;gap:6px 14px;align-items:center;padding:8px 14px;background:#090c1a;border-bottom:1px solid #1a2140;font-size:13px}\n",
        "#bar b{font-size:16px;margin-right:6px}\n",
        "label{display:flex;gap:6px;align-items:center;color:var(--mute)}\n",
        "input[type=range]{width:90px;accent-color:#7fa8c9}\n",
        "input[type=file]{max-width:170px;font:inherit;font-size:12px;color:var(--mute)}\n",
        "button{font:inherit;font-weight:700;color:var(--ink);background:#141a33;border:1px solid #2c3a74;border-radius:6px;padding:6px 12px;cursor:pointer}\n",
        "select{font:inherit;font-size:12px;color:var(--ink);background:#141a33;border:1px solid #2c3a74;border-radius:6px;padding:5px 8px}\n",
        "button:hover:not(:disabled){border-color:#7fa8c9;background:#1a2347}\n",
        "button:disabled{opacity:.4;cursor:not-allowed}\n",
        "button:focus-visible,input:focus-visible{outline:2px solid #7fa8c9;outline-offset:2px}\n",
        "#status{flex-basis:100%;color:#9db88f;min-height:16px;font-size:12px}\n",
        "canvas{flex:1;min-height:0;width:100%;display:block}\n",
        "</style></head>\n",
        "<body>\n",
        "<div id=\"bar\">\n",
        "  <b>LoomBeat</b>\n",
        "  <select id=\"oct\" title=\"节拍倍率:识别成半速时选 ×2\"><option value=\"1\">节拍 ×1</option><option value=\"2\">节拍 ×2</option><option value=\"0.5\">节拍 ×0.5</option></select>\n",
        "  <select id=\"songSel\" hidden aria-label=\"曲目\"><option value=\"0\">曲目 1 · 2:41</option><option value=\"1\">曲目 2 · 3:29</option><option value=\"2\">曲目 3 · 2:50</option><option value=\"3\">曲目 4 · 2:16</option><option value=\"\" disabled>自己的音频</option></select>\n",
        "  <input type=\"file\" id=\"audioFile\" accept=\"audio/*,.mp3,.wav,.ogg,.m4a,.aac,.flac,.opus,audio/mp4,video/mp4\" aria-label=\"音频\">\n",
        "  <input type=\"file\" id=\"chartFile\" accept=\".json,application/json\" aria-label=\"谱面\">\n",
        "  <label>难度 <input id=\"difficulty\" type=\"range\" min=\"0\" max=\"100\" value=\"45\"></label>\n",
        "  <label title=\"音符整体偏早调小、偏晚调大\">音画 <input id=\"av\" type=\"range\" min=\"-300\" max=\"300\" value=\"0\"><span id=\"avv\">0</span>ms</label>\n",
        "  <label title=\"让一只会学习的果蝇脑模型自动演奏,越玩越准\">🪰 <input type=\"checkbox\" id=\"flyOn\"> 果蝇模式</label>\n",
        "  <button id=\"flyReset\" title=\"清除果蝇学到的一切\">重置果蝇</button><span id=\"flyStat\" style=\"color:#9db88f;font-size:12px\"></span>\n",
        "  <button id=\"calBtn\">校准延迟</button>\n",
        "  <button id=\"analyzeBtn\" disabled>识别并生成</button>\n",
        "  <button id=\"playBtn\" disabled>▶ 播放 / 暂停</button>\n",
        "  <button id=\"editBtn\" disabled>编辑:关</button>\n",
        "  <button id=\"exportBtn\" disabled>导出谱面</button>\n",
        "  <div id=\"status\">上传音频文件,然后点击“识别并生成”。按键 D F J K,手机可多点触控。</div>\n",
        "</div>\n",
        "<canvas id=\"game\"></canvas>\n",
        "<div hidden>\n",
        "  <input type=\"range\" id=\"speed\" min=\"300\" max=\"1400\" value=\"520\">\n",
        "  <input type=\"range\" id=\"sync\" min=\"-300\" max=\"300\" value=\"0\">\n",
        "  <input type=\"range\" id=\"variety\" min=\"0\" max=\"100\" value=\"35\">\n",
        "  <input type=\"range\" id=\"minimp\" min=\"0\" max=\"100\" value=\"45\">\n",
        "  <input type=\"checkbox\" id=\"holds\" checked>\n",
        "</div>\n",
        "<script>\n",
        "\"use strict\";\n",
        "const AC=new(window.AudioContext||window.webkitAudioContext)(),$=id=>document.getElementById(id);\n",
        "const cv=$(\"game\"),g=cv.getContext(\"2d\");\n",
        "const COL=[\"#cbd5e1\",\"#7fa8c9\",\"#b39ddb\",\"#c9a227\"],RGB=[\"203,213,225\",\"127,168,201\",\"179,157,219\",\"201,162,39\"];\n",
        "const KEYS=[\"d\",\"f\",\"j\",\"k\"],BANDS=[[20,180],[180,900],[900,3200],[3200,10000]],Z=5;\n",
        "const FONT=s=>`${s} system-ui,-apple-system,'Segoe UI',Roboto,sans-serif`;\n",
        "const setStatus=t=>$(\"status\").textContent=t,round3=x=>Math.round(x*1000)/1000,tick=()=>new Promise(r=>setTimeout(r));\n",
        "let buf=null,feat=null,src=null,chart=null,ns=[],editing=false,selLane=0,playing=false,t0=0,off0=0;\n",
        "let score=0,combo=0,maxCombo=0,judge={t:\"\",at:0,k:\"\"},counts={P:0,G:0,O:0,M:0},result=null;\n",
        "let active=[false,false,false,false],touches=new Map(),parts=[],rings=[],flash=[0,0,0,0],pulse=0,cs=1;\n",
        "const analyser=AC.createAnalyser();analyser.fftSize=256;analyser.smoothingTimeConstant=.78;analyser.connect(AC.destination);\n",
        "const fdata=new Uint8Array(analyser.frequencyBinCount);\n",
        "\n",
        "let W=0,H=0;\n",
        "function resize(){const d=devicePixelRatio||1;W=cv.clientWidth;H=cv.clientHeight;cv.width=W*d;cv.height=H*d;g.setTransform(d,0,0,d,0,0);}\n",
        "new ResizeObserver(resize).observe(cv);\n",
        "function rr(x,y,w,h,r){r=Math.max(0,Math.min(r,w/2,h/2));g.beginPath();g.moveTo(x+r,y);g.arcTo(x+w,y,x+w,y+h,r);g.arcTo(x+w,y+h,x,y+h,r);g.arcTo(x,y+h,x,y,r);g.arcTo(x,y,x+w,y,r);g.closePath();}\n",
        "function geom(){const hy=H*.2,hitY=H*.82;return{cx:W/2,hy,hitY,hw:Math.min(W*.46,(hitY-hy)*.9)};}\n",
        "\n",
        "/* ---------- Analysis ---------- */\n",
        "function fft(re,im){const n=re.length;\n",
        "  for(let i=1,j=0;i<n;i++){let b=n>>1;for(;j&b;b>>=1)j^=b;j^=b;if(i<j){let t=re[i];re[i]=re[j];re[j]=t;t=im[i];im[i]=im[j];im[j]=t;}}\n",
        "  for(let len=2;len<=n;len<<=1){const a=-2*Math.PI/len,wr=Math.cos(a),wi=Math.sin(a),h=len>>1;\n",
        "    for(let i=0;i<n;i+=len){let cr=1,ci=0;for(let j=0;j<h;j++){const u=i+j,v=u+h,xr=re[v]*cr-im[v]*ci,xi=re[v]*ci+im[v]*cr;\n",
        "      re[v]=re[u]-xr;im[v]=im[u]-xi;re[u]+=xr;im[u]+=xi;const nr=cr*wr-ci*wi;ci=cr*wi+ci*wr;cr=nr;}}}}\n",
        "\n",
        "// Stage 1 (slow, cached per song): per-band spectral flux + tempo/phase + fine attack envelope\n",
        "async function extract(b){\n",
        "  const dec=Math.max(1,Math.round(b.sampleRate/22050)),sr=b.sampleRate/dec,n=Math.floor(b.length/dec);\n",
        "  const chs=[];for(let i=0;i<b.numberOfChannels;i++)chs.push(b.getChannelData(i));\n",
        "  const mono=new Float32Array(n);\n",
        "  for(let i=0;i<n;i++){let s=0;for(let d=0;d<dec;d++)for(const c of chs)s+=c[i*dec+d];mono[i]=s/(dec*chs.length);}\n",
        "  // fine attack envelope (|first difference|, 2 ms box): used to place each onset at the real waveform attack\n",
        "  const ae=new Float32Array(n),bw=Math.max(2,Math.round(sr*.002));\n",
        "  {let acc=0;const q=new Float32Array(bw);for(let i=1;i<n;i++){const v=Math.abs(mono[i]-mono[i-1]);acc+=v-q[i%bw];q[i%bw]=v;ae[i]=acc/bw;}}\n",
        "  const N=1024,HOP=256,F=Math.floor((n-N)/HOP);if(F<100)return null;\n",
        "  const win=new Float32Array(N);for(let i=0;i<N;i++)win[i]=.5-.5*Math.cos(2*Math.PI*i/(N-1));\n",
        "  const bandOf=new Int8Array(N/2).fill(-1),cntB=[0,0,0,0];\n",
        "  BANDS.forEach(([a,z],i)=>{for(let k=Math.max(1,Math.round(a*N/sr));k<=Math.min(N/2-1,Math.round(z*N/sr));k++){bandOf[k]=i;cntB[i]++;}});\n",
        "  const re=new Float32Array(N),im=new Float32Array(N),prev=new Float32Array(N/2);\n",
        "  const flux=[0,1,2,3].map(()=>new Float32Array(F)),en=[0,1,2,3].map(()=>new Float32Array(F));\n",
        "  for(let f=0;f<F;f++){\n",
        "    const o=f*HOP;for(let i=0;i<N;i++){re[i]=mono[o+i]*win[i];im[i]=0;}\n",
        "    fft(re,im);\n",
        "    for(let k=1;k<N/2;k++){const m=Math.log1p(300*Math.hypot(re[k],im[k])/N),d=m-prev[k];prev[k]=m;const bd=bandOf[k];if(bd<0)continue;if(d>0)flux[bd][f]+=d;en[bd][f]+=m;}\n",
        "    if(f%300===0){setStatus(`分析频谱 ${Math.round(f/F*100)}%`);await tick();}\n",
        "  }\n",
        "  // one shared scale for all bands: a loud change counts for more than a tiny change in a quiet band\n",
        "  const mm=flux.map((a,b2)=>{let m=0;for(let f=0;f<F;f++)m+=a[f];return(m/F||1e-9)/Math.max(1,cntB[b2]);});\n",
        "  const G=mm.reduce((x,y)=>x+y,0)/4,bmean=mm.map(v=>v/G);\n",
        "  const nflux=[],floor=[],med=[];\n",
        "  for(let b2=0;b2<4;b2++){\n",
        "    nflux.push(flux[b2].map(v=>v/Math.max(1,cntB[b2])/G));\n",
        "    const s=new Float32Array(F);for(let f=3;f<F-3;f++){let a=0;for(let j=-3;j<=3;j++)a+=en[b2][f+j];s[f]=a/7;}\n",
        "    en[b2]=s;const so=Float32Array.from(s).sort();floor.push(so[Math.floor(F*.1)]);med.push(so[F>>1]);\n",
        "  }\n",
        "  setStatus(\"估计节拍…\");await tick();\n",
        "  const sm=new Float32Array(F),dt=HOP/sr;\n",
        "  for(let f=2;f<F-2;f++){let a=0;for(let b2=0;b2<4;b2++){const x=nflux[b2];a+=x[f-2]+2*x[f-1]+3*x[f]+2*x[f+1]+x[f+2];}sm[f]=a/9;}\n",
        "  let mu=0;for(const v of sm)mu+=v;mu/=F;for(let f=0;f<F;f++)sm[f]=Math.max(0,sm[f]-mu);\n",
        "  let avg=0;for(const v of sm)avg+=v;avg=avg/F||1e-9;\n",
        "  const comb=bpm=>{const L=60/bpm/dt;let best=-1,bp=0;\n",
        "    for(let p=0;p<L;p++){let s=0,c=0;for(let k=0;;k++){const i=Math.round(p+k*L);if(i>=F)break;s+=sm[i];c++;}s/=c;if(s>best){best=s;bp=p;}}\n",
        "    return{s:best,p:bp};};\n",
        "  let bb=120,bs=-1;\n",
        "  for(let x=70;x<=180;x+=.1){const w=Math.exp(-.5*Math.pow(Math.log2(x/120)/.7,2)),r=comb(x);if(r.s*w>bs){bs=r.s*w;bb=x;}}\n",
        "  let bp=0,raw=0,c0=bb;\n",
        "  for(let x=c0-.15;x<=c0+.15;x+=.01){const r=comb(x);if(r.s>raw){raw=r.s;bb=x;bp=r.p;}}\n",
        "  return{sr,N,HOP,F,dt,ae,nflux,bmean,en,floor,med,bpm:bb,off:(bp*HOP+N/2)/sr,conf:raw/avg};\n",
        "}\n",
        "\n",
        "// Stage 2 (fast, re-run when any slider changes): rank events by importance, keep the best, spread them over lanes\n",
        "const LEAD=.015;   // fallback only: seconds added to the STFT-based attack time when the waveform has no clear attack\n",
        "function mulberry(a){return()=>{a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}\n",
        "function build(ft,diff,holdsOn,variety,imp01,gapB,mul){\n",
        "  const{F,dt,nflux,bmean,en,floor,med,N,HOP,sr,ae}=ft,tOf=f=>(f*HOP+N/2)/sr,w2=Math.round(.05/dt),lw=Math.round(.6/dt),minImp=.6+imp01*1.6;\n",
        "  // sample-accurate attack time: find the rising edge of the waveform envelope just before the detected flux peak\n",
        "  const refine=tc=>{const i0=Math.max(1,Math.round((tc-.055)*sr)),i1=Math.min(ae.length-1,Math.round((tc+.02)*sr));\n",
        "    if(i1-i0<8)return null;let pk=i0,mx=0;for(let i=i0;i<=i1;i++)if(ae[i]>mx){mx=ae[i];pk=i;}\n",
        "    let base=mx;for(let i=i0;i<=pk;i++)if(ae[i]<base)base=ae[i];\n",
        "    if(mx-base<1e-4||mx<2*base)return null;\n",
        "    const thr=base+.2*(mx-base);let i=pk;while(i>i0&&ae[i-1]>=thr)i--;\n",
        "    return i<=i0+1?null:i/sr;};\n",
        "  // 1. onset events: loudness-weighted flux peaks, importance = size relative to the whole song\n",
        "  const raw=new Float32Array(F),env=new Float32Array(F);\n",
        "  for(let b=0;b<4;b++)for(let f=0;f<F;f++)raw[f]+=nflux[b][f]*.25;\n",
        "  for(let f=1;f<F-1;f++)env[f]=(raw[f-1]+2*raw[f]+raw[f+1])/4;\n",
        "  const pre=new Float64Array(F+1);for(let f=0;f<F;f++)pre[f+1]=pre[f]+env[f];\n",
        "  const ev=[];\n",
        "  for(let f=2;f<F-2;f++){\n",
        "    const lo=Math.max(0,f-lw),hi=Math.min(F,f+lw+1),thr=Math.max((pre[hi]-pre[lo])/(hi-lo)*1.1+.2,minImp);\n",
        "    if(env[f]<thr||env[f]<env[f-1]||env[f]<=env[f+1])continue;\n",
        "    let ok=true;for(let j=Math.max(0,f-w2);j<=Math.min(F-1,f+w2);j++)if(env[j]>env[f]){ok=false;break;}\n",
        "    if(!ok)continue;\n",
        "    const rel=b=>Math.max(nflux[b][f-1],nflux[b][f],nflux[b][f+1])/bmean[b];\n",
        "    const ranks=[0,1,2,3].sort((x,y)=>rel(y)-rel(x));\n",
        "    let s=f;for(let j=f-1;j>=Math.max(1,f-6);j--){if(env[j]>=env[f]*.35)s=j;else break;}\n",
        "    ev.push({f,t:Math.max(0,refine(tOf(f))??(tOf(s)+LEAD)),imp:env[f],lane:ranks[0],dur:0,ranks});\n",
        "  }\n",
        "  // 2. beat grid, measured from the events themselves and tracked locally (±4 s), so a slightly wrong BPM or a drifting\n",
        "  //    band can't drag notes off the music. Phase comes from a weighted circular mean of event times at the beat (h=1)\n",
        "  //    and 16th (h=4) periods; R is how well events really sit on that grid (≈0 for random timing).\n",
        "  const n=ev.length,TW=2*Math.PI;\n",
        "  // local (4 s block) coherence of events with a period, so tempo drift can't hide real alignment\n",
        "  const cohB=(p,h)=>{let tot=0,wt=0;for(let i=0;i<n;){let j=i;while(j<n&&ev[j].t<ev[i].t+4)j++;\n",
        "    if(j-i>=8){let c=0,s=0,w=0;for(let k=i;k<j;k++){const e=ev[k],a=TW*h*e.t/p;c+=e.imp*Math.cos(a);s+=e.imp*Math.sin(a);w+=e.imp;}tot+=Math.hypot(c,s);wt+=w;}i=j;}return wt?tot/wt:0;};\n",
        "  // breakcore / fast breaks: if the tempo was found at half speed (events also sit on the in-between beats), double it\n",
        "  let per=60/(ft.bpm*(mul||1)),half=false;\n",
        "  if(!mul||mul===1)if(n>40&&ft.bpm*2<=240){const c1=cohB(per,4),c2=cohB(per/2,4);if(c1<.5&&c2>c1+.15){per/=2;half=true;}}\n",
        "  const g4=per/4,TOL=Math.min(.03,g4*.2);\n",
        "  const mk=h=>{const c=new Float64Array(n+1),s=new Float64Array(n+1),w=new Float64Array(n+1);\n",
        "    ev.forEach((e,i)=>{const a=TW*h*e.t/per;c[i+1]=c[i]+e.imp*Math.cos(a);s[i+1]=s[i]+e.imp*Math.sin(a);w[i+1]=w[i]+e.imp;});return{c,s,w};};\n",
        "  const P1=mk(1),P4=mk(4),loc=(P,i,j)=>{const c=P.c[j]-P.c[i],s=P.s[j]-P.s[i],w=P.w[j]-P.w[i]||1e-9;return{R:Math.hypot(c,s)/w,ph:Math.atan2(s,c)/TW};};\n",
        "  let lo=0,hi=0,okN=0;\n",
        "  for(let i=0;i<n;i++){const e=ev[i];while(ev[lo].t<e.t-4)lo++;while(hi<n&&ev[hi].t<=e.t+4)hi++;\n",
        "    if(hi-lo<8)continue;const a=loc(P4,lo,hi);if(a.R<.4)continue;\n",
        "    const b=loc(P1,lo,hi),p4=a.ph*g4,k=Math.round((e.t-p4)/g4),kb=Math.round((b.ph*per-p4)/g4);\n",
        "    e.grid=true;e.q=p4+k*g4;e.err=e.t-e.q;e.sub=(((k-kb)%4)+4)%4;okN++;}\n",
        "  const useGrid=n>0&&okN>n*.5,g1=n?loc(P1,0,n):{ph:0},off=((g1.ph*per)%per+per)%per;\n",
        "  // exact tempo + phase: weighted line fit through on-beat events (beat index → time), so the displayed grid cannot drift\n",
        "  let bpmOut=60/per,offOut=off;\n",
        "  if(useGrid){const pts=ev.filter(e=>e.grid&&e.sub===0&&Math.abs(e.err)<TOL*1.5);\n",
        "    if(pts.length>=16){let P=per,O=off;\n",
        "      for(let it=0;it<3;it++){let sw=0,sx=0,sy=0,sxx=0,sxy=0;\n",
        "        for(const e of pts){const m=Math.round((e.q-O)/P),w=e.imp;sw+=w;sx+=w*m;sy+=w*e.t;sxx+=w*m*m;sxy+=w*m*e.t;}\n",
        "        const d=sw*sxx-sx*sx;if(d<=0)break;const s=(sw*sxy-sx*sy)/d,i0=(sy-s*sx)/sw;\n",
        "        if(Math.abs(s/per-1)>.01)break;P=s;O=i0;}\n",
        "      bpmOut=60/P;offOut=((O%P)+P)%P;}}\n",
        "  const cand=[];\n",
        "  for(const e of ev){\n",
        "    e.score=e.imp;\n",
        "    if(e.grid){e.score=e.imp*(e.sub===0?1.35:e.sub===2?1.1:.85);\n",
        "      if(Math.abs(e.err)<TOL){e.t=round3(e.q);if(e.sub%2&&(diff<.35||e.imp<minImp*1.1))continue;}   // snap only when really close\n",
        "      else if(e.imp<minImp*1.1)continue;}\n",
        "    cand.push(e);\n",
        "  }\n",
        "  // 3. holds (unchanged)\n",
        "  if(holdsOn)for(const e of cand){\n",
        "    if(e.imp<minImp)continue;const a=e.f+4;if(a+8>=F||e.f<10)continue;let best=0,bl=e.lane;\n",
        "    for(let b=0;b<4;b++){\n",
        "      let e0=0,pr=0;for(let j=a;j<a+4;j++)e0+=en[b][j];e0/=4;for(let j=e.f-8;j<e.f-2;j++)pr+=en[b][j];pr/=6;\n",
        "      if(e0-floor[b]<1.5*(med[b]-floor[b])||e0-pr<.5*(e0-floor[b]))continue;\n",
        "      const lim=floor[b]+.65*(e0-floor[b]);let f2=a+4;\n",
        "      while(f2<F-1&&(f2-e.f)*dt<2.4&&en[b][f2]>lim&&nflux[b][f2]<10)f2++;\n",
        "      const d=(f2-e.f)*dt;if(d>best){best=d;bl=b;}\n",
        "    }\n",
        "    if(best>=.8){e.dur=best;e.lane=bl;}\n",
        "  }\n",
        "  // 4. spacing (unchanged)\n",
        "  cand.sort((a,b)=>b.score-a.score);\n",
        "  // dense material (short typical gap between onsets) gets proportionally smaller spacing limits\n",
        "  const gp=[];for(let i=1;i<n;i++)gp.push(ev[i].t-ev[i-1].t);gp.sort((a,b)=>a-b);const sc=Math.max(.45,Math.min(1,(gp[gp.length>>1]||.2)/.2));\n",
        "  const acc=[],gL=Math.max((useGrid?per*(.8-.55*diff):.4-.22*diff)*sc,per*(gapB||0)),gA=Math.max((useGrid?per*(.32-.22*diff):.2-.08*diff)*sc,per*(gapB||0));\n",
        "  for(const c of cand){\n",
        "    if(acc.some(a=>a.lane===c.lane&&c.t<a.t+a.dur+gL&&a.t<c.t+c.dur+gL))continue;\n",
        "    const near=acc.filter(a=>Math.abs(a.t-c.t)<gA);\n",
        "    if(near.length&&(diff<.6||near.length>1||near.some(a=>Math.abs(a.t-c.t)>.045)))continue;\n",
        "    acc.push(c);\n",
        "  }\n",
        "  acc.sort((a,b)=>a.t-b.t);let lastH=-9;\n",
        "  for(const a of acc)if(a.dur){if(a.t<lastH+1.5)a.dur=0;else lastH=a.t+a.dur;}\n",
        "  // 5. variety (unchanged)\n",
        "  const rng=mulberry(1234567),cnt=[0,0,0,0],rec=[];\n",
        "  for(const n of acc){\n",
        "    if(!n.dur&&variety>0){\n",
        "      const tot=cnt[0]+cnt[1]+cnt[2]+cnt[3]+1;let bl=n.lane,bs=-9;\n",
        "      n.ranks.forEach((l,i)=>{\n",
        "        if(acc.some(a=>a!==n&&a.lane===l&&(a.dur?(n.t>a.t-.15&&n.t<a.t+a.dur+.15):Math.abs(a.t-n.t)<.12)))return;\n",
        "        const sc=-i*(1.6-1.3*variety)-(rec.slice(-2).includes(l)?2.2*variety:0)-cnt[l]/tot*4*variety+rng()*.8*variety;\n",
        "        if(sc>bs){bs=sc;bl=l;}});\n",
        "      n.lane=bl;\n",
        "    }\n",
        "    cnt[n.lane]++;rec.push(n.lane);\n",
        "  }\n",
        "  const notes=acc.map(c=>({t:round3(c.t),lane:c.lane,type:c.dur?\"hold\":\"tap\",duration:c.dur?round3(c.dur):0})).filter(n=>n.t>.3);\n",
        "  return{bpm:round3(bpmOut),offset:round3(offOut),grid:useGrid,notes,diag:{half,sc,okN,n}};\n",
        "}\n",
        "\n",
        "/* ---------- File + transport ---------- */\n",
        "function refreshUI(){$(\"playBtn\").disabled=!(buf&&chart);$(\"editBtn\").disabled=!chart;$(\"exportBtn\").disabled=!chart;}\n",
        "function setChart(c){chart=c;ns=[];off0=0;result=null;refreshUI();}\n",
        "function regen(){try{\n",
        "  const mul=+$(\"oct\").value||1,d=$(\"difficulty\").value/100,hd=$(\"holds\").checked,v=$(\"variety\").value/100;let imp=$(\"minimp\").value/100,c=build(feat,d,hd,v,imp,0,mul),relaxed=false;\n",
        "  const need=Math.floor((buf?buf.duration:60)*1.2);   // safety net: aim for a comfortably dense chart\n",
        "  let guard=0;\n",
        "  while(c.notes.length<need&&imp>0&&guard++<8){imp=Math.max(0,imp-.2);c=build(feat,d,hd,v,imp,0,mul);relaxed=true;}\n",
        "  if(relaxed)$(\"minimp\").value=Math.round(imp*100);\n",
        "  setChart(c);setStatus(`完成:${c.notes.length} 个音符(${c.notes.filter(n=>n.type===\"hold\").length} 长条)· BPM ${c.bpm}${c.grid?\"\":\"(节拍不稳,未对齐网格)\"}${relaxed?\" · 音符偏少,已自动降低重要度\":\"\"}`);\n",
        "}catch(err){console.error(err);setStatus(\"生成失败:\"+(err&&err.message||err));}}\n",
        "$(\"audioFile\").addEventListener(\"change\",async e=>{const f=e.target.files[0];if(!f)return;songTok++;$(\"songSel\").value=\"\";$(\"oct\").value=\"1\";setStatus(\"解码音频中…\");stopAudio();\n",
        "  try{await AC.resume();buf=await AC.decodeAudioData(await f.arrayBuffer());feat=null;chart=null;ns=[];off0=0;result=null;refreshUI();$(\"analyzeBtn\").disabled=false;setStatus(`已加载:${f.name}(${buf.duration.toFixed(1)} 秒)。点击“识别并生成”。`);}\n",
        "  catch(err){setStatus(`无法解码 ${f.name}:浏览器不支持该格式。请改用 MP3 / WAV / OGG / M4A。`);}});\n",
        "$(\"chartFile\").addEventListener(\"change\",async e=>{const f=e.target.files[0];if(!f)return;\n",
        "  try{const j=JSON.parse(await f.text());setChart({bpm:j.bpm||120,offset:j.offset||0,grid:!!j.grid,notes:j.notes.map(n=>({t:n.t||0,lane:n.lane||0,type:n.type||\"tap\",duration:n.duration||0})).sort((a,b)=>a.t-b.t)});setStatus(`导入完成:${chart.notes.length} 个音符。`);}\n",
        "  catch(err){setStatus(\"谱面文件无效。\");}});\n",
        "$(\"analyzeBtn\").addEventListener(\"click\",async()=>{if(!buf)return;$(\"analyzeBtn\").disabled=true;stopAudio();\n",
        "  try{if(!feat)feat=await extract(buf);if(!feat)setStatus(\"音频太短,无法分析。\");else regen();}catch(err){console.error(err);setStatus(\"生成失败:\"+(err&&err.message||err));}\n",
        "  $(\"analyzeBtn\").disabled=false;});\n",
        "$(\"oct\").addEventListener(\"change\",()=>{if(feat&&!playing)regen();});\n",
        "$(\"difficulty\").addEventListener(\"change\",()=>{if(feat&&!playing)regen();});\n",
        "[\"holds\",\"variety\",\"minimp\"].forEach(id=>$(id).addEventListener(\"change\",()=>{if(feat&&!playing)regen();}));   // re-pick instantly, no re-analysis\n",
        "let dl=null;\n",
        "(async()=>{try{dl=window.claude&&await claude.use(\"downloads\");}catch(e){dl=null;}})();\n",
        "$(\"exportBtn\").addEventListener(\"click\",async()=>{if(!chart)return;const json=JSON.stringify(chart,null,2);\n",
        "  if(dl){try{await dl.save({filename:\"chart.json\",data:json});}catch(err){if(!err||err.code!==\"declined\")setStatus(\"导出失败,请重试。\");}return;}\n",
        "  const a=document.createElement(\"a\");a.href=URL.createObjectURL(new Blob([json],{type:\"application/json\"}));a.download=\"chart.json\";document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),1000);});\n",
        "$(\"editBtn\").addEventListener(\"click\",()=>{editing=!editing;if(editing)stopAudio();ns=[];$(\"editBtn\").textContent=`编辑:${editing?\"开\":\"关\"}`;});\n",
        "\n",
        "const pos=()=>playing?off0+AC.currentTime-t0:off0;\n",
        "const vis=()=>pos()-outLat()+$(\"av\").value/1000;   // what is drawn: lines up with what you HEAR\n",
        "const now=()=>vis()+$(\"sync\").value/1000;          // what is judged: also compensates your own tap delay\n",
        "let tickTimer=null,tickI=0,tickBus=null;\n",
        "function startTicks(){clearInterval(tickTimer);tickBus=null;}   // metronome clicks removed\n",
        "function stopAudio(){if(playing)off0=Math.max(0,off0+AC.currentTime-t0);clearInterval(tickTimer);if(tickBus){try{tickBus.disconnect();}catch(e){}tickBus=null;}const s=src;src=null;if(s){try{s.stop();}catch(e){}}playing=false;active=[false,false,false,false];touches.clear();$(\"playBtn\").textContent=\"▶ 播放 / 暂停\";}\n",
        "function playFrom(o){stopAudio();if(!buf||!chart)return;off0=Math.max(0,o);result=null;\n",
        "  if(!ns.length||off0===0){ns=chart.notes.map(n=>({...n,hit:false,missed:false,holding:false,done:false,broken:false}));score=combo=maxCombo=0;counts={P:0,G:0,O:0,M:0};parts=[];rings=[]}\n",
        "  const s=AC.createBufferSource();s.buffer=buf;s.connect(analyser);const st=AC.currentTime+.06;s.start(st,off0);src=s;t0=st;playing=true;startTicks();$(\"playBtn\").textContent=\"⏸ 暂停\";\n",
        "  s.onended=()=>{if(src===s&&playing){stopAudio();finish();}};}\n",
        "function finish(){const T=ns.length;if(!T||editing)return;const a=(counts.P+counts.G*.8+counts.O*.5)/T;result={a,rank:a>=.95?\"S\":a>=.9?\"A\":a>=.8?\"B\":a>=.65?\"C\":\"D\"};off0=0;}\n",
        "$(\"playBtn\").addEventListener(\"click\",async()=>{await AC.resume();if(playing)stopAudio();else playFrom(off0);});\n",
        "\n",
        "/* ---------- Fruit fly player ---------- */\n",
        "// A small spiking \"fly brain\" (leaky integrate-and-fire reservoir) plays the chart. Same recipe as the fly_learns notebook:\n",
        "// fixed random recurrent wiring W0, a fast linear readout w_fast trained online (normalised LMS), and reward-modulated\n",
        "// plasticity on the recurrent synapses (eligibility = pre*post activity, decay back to W0, clipped).\n",
        "const Fly=(()=>{\n",
        "  const N=160,L=4,CT=[-.06,-.03,0,.03,.06,.1,.15,.22,.3,.4],K=CT.length,NIN=L*K,P_REC=.08,P_IN=.3;\n",
        "  const LR_READOUT=.015,WD_READOUT=1e-4,LR_SYN=.004,W_DECAY=.01,W_CLIP=4,POS_W=6;\n",
        "  const rnd=mulberry(20261020),SIG=.02;\n",
        "  const pre=[],post=[],w0=[];\n",
        "  for(let i=0;i<N;i++)for(let j=0;j<N;j++)if(i!==j&&rnd()<P_REC){pre.push(i);post.push(j);w0.push(rnd()<.8?.05+.06*rnd():-(.1+.1*rnd()));}\n",
        "  const S=pre.length,PRE=Int16Array.from(pre),POST=Int16Array.from(post),W0=Float32Array.from(w0);\n",
        "  const win=new Float32Array(N*NIN);for(let j=0;j<N;j++)for(let k=0;k<NIN;k++)if(rnd()<P_IN)win[j*NIN+k]=(rnd()<.85?1:-1)*(.12+.3*rnd());\n",
        "  const th=Float32Array.from({length:N},()=>1+.35*rnd());\n",
        "  const f={N,S,W:new Float32Array(W0),wf:[0,1,2,3].map(()=>new Float32Array(N+1)),seen:0,hits:0,miss:0,acc:0,frames:0,\n",
        "    v:new Float32Array(N),s:new Float32Array(N),x:new Float32Array(N+1),el:new Float32Array(S),u:new Float32Array(NIN),y:[0,0,0,0]};\n",
        "  f.x[N]=1;\n",
        "  f.step=(dt,tau,learn)=>{\n",
        "    const{v,s,x,u,W,el}=f,a=Math.exp(-dt/.04),b=Math.exp(-dt/.05),e=Math.exp(-dt/.3);\n",
        "    for(let l=0;l<L;l++){const t=tau[l];for(let k=0;k<K;k++)u[l*K+k]=t===null?0:Math.exp(-.5*((t-CT[k])/SIG)**2);}\n",
        "    const rec=new Float32Array(N);for(let q=0;q<S;q++)if(s[PRE[q]])rec[POST[q]]+=W[q];\n",
        "    for(let j=0;j<N;j++){let I=0;const o=j*NIN;for(let k=0;k<NIN;k++)if(u[k]>.01)I+=win[o+k]*u[k];\n",
        "      let vj=v[j]*a+I+rec[j]+.04*(Math.random()+Math.random()-1);\n",
        "      if(vj>th[j]){s[j]=1;vj=0;}else s[j]=0;v[j]=vj;x[j]=x[j]*b+s[j]*(1-b);}\n",
        "    for(let q=0;q<S;q++)el[q]=el[q]*e+x[PRE[q]]*x[POST[q]];\n",
        "    let xx=1e-6;for(let j=0;j<=N;j++)xx+=x[j]*x[j];\n",
        "    for(let l=0;l<L;l++){const w=f.wf[l];let y=0;for(let j=0;j<=N;j++)y+=w[j]*x[j];f.y[l]=y;\n",
        "      if(learn){const tg=tau[l]!==null&&Math.abs(tau[l])<.04?1:0,err=tg-y,g=LR_READOUT*err*(tg?POS_W:1)/xx;\n",
        "        for(let j=0;j<=N;j++){w[j]=(1-WD_READOUT)*w[j]+g*x[j];if(w[j]>200)w[j]=200;else if(w[j]<-200)w[j]=-200;}}}\n",
        "    f.frames++;return f.y;};\n",
        "  f.reward=r=>{const{W,el}=f;let m=1e-9;for(let q=0;q<S;q++)if(el[q]>m)m=el[q];\n",
        "    for(let q=0;q<S;q++){const c=Math.abs(W0[q])*W_CLIP+1e-6;let w=W[q]+LR_SYN*r*(el[q]/m)*Math.abs(W0[q])*10-W_DECAY*(W[q]-W0[q]);W[q]=w>c?c:w<-c?-c:w;}};\n",
        "  f.note=(hit,good)=>{f.seen++;if(hit)f.hits++;else f.miss++;f.acc=f.acc*.96+.04*(good);};\n",
        "  f.reset=()=>{f.W.set(W0);f.wf.forEach(w=>w.fill(0));f.seen=f.hits=f.miss=f.acc=f.frames=0;f.v.fill(0);f.s.fill(0);f.x.fill(0);f.x[N]=1;f.el.fill(0);};\n",
        "  f.dump=()=>JSON.stringify({W:Array.from(f.W,v=>+v.toFixed(5)),wf:f.wf.map(w=>Array.from(w,v=>+v.toFixed(4))),seen:f.seen,hits:f.hits,miss:f.miss,acc:f.acc,frames:f.frames});\n",
        "  f.load=str=>{const d=JSON.parse(str);if(d.W.length!==S||d.wf[0].length!==N+1)return false;f.W.set(d.W);d.wf.forEach((w,l)=>f.wf[l].set(w));f.seen=d.seen|0;f.hits=d.hits|0;f.miss=d.miss|0;f.acc=+d.acc||0;f.frames=d.frames|0;return true;};\n",
        "  return f;})();\n",
        "\n",
        "/* ---------- Gameplay ---------- */\n",
        "const bump=()=>{combo++;maxCombo=Math.max(maxCombo,combo);cs=1.1;};\n",
        "function fx(l,perfect){const{cx,hitY,hw}=geom(),x=cx+(l-1.5)*hw/2,c=perfect?\"255,255,255\":RGB[l];flash[l]=1;\n",
        "  for(let i=0;i<7;i++)parts.push({x,y:hitY,vx:(Math.random()-.5)*14,vy:-Math.random()*9-1,l:1,d:.03+Math.random()*.04,c,w:1+Math.random()*3});\n",
        "  rings.push({x,y:hitY,r:8,l:1,c});}\n",
        "function press(l){if(!playing||editing)return;const ct=now();let b=null;\n",
        "  for(const n of ns){if(n.t>ct+.25)break;if(n.lane===l&&!n.hit&&!n.missed&&n.t>=ct-.25){b=n;break;}}\n",
        "  if(!b)return;const d=Math.abs(b.t-ct),k=d<.09?\"P\":d<.16?\"G\":\"O\";\n",
        "  b.hit=true;if(b.type===\"hold\")b.holding=true;counts[k]++;\n",
        "  judge={t:{P:\"PERFECT\",G:\"GREAT\",O:\"GOOD\"}[k],at:performance.now(),k};\n",
        "  score+={P:300,G:200,O:100}[k]+Math.min(combo,50)*2;bump();fx(l,k===\"P\");}\n",
        "function release(l){if(!playing||editing)return;const ct=now();\n",
        "  for(const n of ns)if(n.lane===l&&n.holding){n.holding=false;\n",
        "    if(ct>=n.t+n.duration-.3){n.done=true;score+=150;bump();fx(l,true);}\n",
        "    else{n.broken=true;combo=0;judge={t:\"BREAK\",at:performance.now(),k:\"M\"};}}}\n",
        "addEventListener(\"keydown\",e=>{if(e.repeat)return;if(cal){if(e.key===\"Escape\"){cal=null;setStatus(\"已取消校准。\");}else calTap();e.preventDefault();return;}const k=e.key.toLowerCase();\n",
        "  if(editing){\n",
        "    if(\"1234\".includes(k)&&k)selLane=+k-1;\n",
        "    if((k===\"a\"||k===\"h\")&&chart){chart.notes.push({t:round3(vis()),lane:selLane,type:k===\"a\"?\"tap\":\"hold\",duration:k===\"a\"?0:.5});chart.notes.sort((a,b)=>a.t-b.t);ns=[];}\n",
        "    if(k===\"x\"&&chart){const ct=vis(),d=chart.notes.slice().sort((a,b)=>Math.abs(a.t-ct)-Math.abs(b.t-ct))[0];if(d){chart.notes=chart.notes.filter(n=>n!==d);ns=[];}}\n",
        "    if(k===\" \"){e.preventDefault();AC.resume();playing?stopAudio():playFrom(off0);}\n",
        "    if(k===\"arrowleft\"&&!playing)off0=Math.max(0,off0-.1);\n",
        "    if(k===\"arrowright\"&&!playing)off0+=.1;\n",
        "    return;}\n",
        "  const l=KEYS.indexOf(k);if(l>=0&&!active[l]){active[l]=true;AC.resume();press(l);}});\n",
        "addEventListener(\"keyup\",e=>{const l=KEYS.indexOf(e.key.toLowerCase());if(l>=0&&!editing){active[l]=false;release(l);}});\n",
        "const laneAt=x=>{const{cx,hw}=geom();return Math.max(0,Math.min(3,Math.floor((x-(cx-hw))/(hw/2))));};\n",
        "cv.addEventListener(\"pointerdown\",e=>{e.preventDefault();AC.resume();if(cal){calTap();return;}cv.setPointerCapture(e.pointerId);\n",
        "  const l=laneAt(e.clientX-cv.getBoundingClientRect().left);touches.set(e.pointerId,l);\n",
        "  if(editing)selLane=l;else if(!active[l]){active[l]=true;press(l);}});\n",
        "const up=e=>{if(!touches.has(e.pointerId))return;const l=touches.get(e.pointerId);touches.delete(e.pointerId);\n",
        "  if(!editing&&![...touches.values()].includes(l)){active[l]=false;release(l);}};\n",
        "cv.addEventListener(\"pointerup\",up);cv.addEventListener(\"pointercancel\",up);\n",
        "\n",
        "/* ---------- Tap-sync calibration ---------- */\n",
        "let cal=null;\n",
        "const outLat=()=>AC.outputLatency||AC.baseLatency||0;\n",
        "async function startCal(){await AC.resume();stopAudio();editing=false;$(\"editBtn\").textContent=\"编辑:关\";$(\"calBtn\").blur();\n",
        "  const st=AC.currentTime+1.2,beeps=[];\n",
        "  for(let i=0;i<12;i++){const T=st+i*.75;beeps.push(T);const o=AC.createOscillator(),v=AC.createGain();o.frequency.value=1000;\n",
        "    v.gain.setValueAtTime(0,T);v.gain.linearRampToValueAtTime(.5,T+.003);v.gain.exponentialRampToValueAtTime(.001,T+.07);\n",
        "    o.connect(v);v.connect(AC.destination);o.start(T);o.stop(T+.1);}\n",
        "  cal={beeps,d:{}};setStatus(\"校准中:听到“嘀”声的瞬间点击(前两声用来热身)。\");}\n",
        "function calTap(){const t=AC.currentTime-outLat();let bi=0,bd=9;\n",
        "  cal.beeps.forEach((T,i)=>{const d=Math.abs(t-T);if(d<bd){bd=d;bi=i;}});\n",
        "  if(bi>=2&&bd<.375)cal.d[bi]=t-cal.beeps[bi];}\n",
        "function finishCal(){const v=Object.values(cal.d).sort((a,b)=>a-b);cal=null;\n",
        "  if(v.length<4){setStatus(\"点击次数太少,请重试校准。\");return;}\n",
        "  const ms=Math.max(-300,Math.min(300,Math.round(-v[v.length>>1]*1000))),sp=Math.round((v[v.length-1]-v[0])*1000);\n",
        "  $(\"sync\").value=ms;\n",
        "  setStatus(`校准完成:同步 ${ms} ms(${v.length} 次点击,波动 ${sp} ms)${sp>150?\" — 波动较大,建议重试\":\"\"}。`);}\n",
        "function drawCal(){const{cx,hy,hitY}=geom(),cy=(hy+hitY)/2,t=AC.currentTime-outLat();\n",
        "  if(t>cal.beeps[11]+.6){finishCal();return;}\n",
        "  let age=9;for(const T of cal.beeps)if(t>=T&&t-T<age)age=t-T;\n",
        "  const f=Math.max(0,1-age/.25);\n",
        "  g.fillStyle=`rgba(127,168,201,${.12+.45*f})`;g.beginPath();g.arc(cx,cy,50+40*f,0,6.283);g.fill();\n",
        "  g.strokeStyle=\"#fff\";g.lineWidth=3;g.beginPath();g.arc(cx,cy,50,0,6.283);g.stroke();\n",
        "  g.textAlign=\"center\";g.fillStyle=\"#fff\";g.font=FONT(\"700 22px\");g.fillText(\"听到“嘀”声的瞬间,点击任意键或屏幕\",cx,cy-110);\n",
        "  g.fillStyle=\"#9fb0e0\";g.font=FONT(\"500 15px\");g.fillText(`已记录 ${Object.keys(cal.d).length} 次 · Esc 取消`,cx,cy+120);}\n",
        "$(\"calBtn\").addEventListener(\"click\",startCal);\n",
        "$(\"av\").addEventListener(\"input\",()=>$(\"avv\").textContent=$(\"av\").value);\n",
        "\n",
        "/* ---------- Fruit fly control ---------- */\n",
        "const FKEY=\"loombeat.fly.v1\";let flyLast=performance.now(),flyRel=[0,0,0,0],flyCool=[0,0,0,0],flyWas=false,flySnap={P:0,G:0,O:0,M:0},flySave=0,flyTxt=0;\n",
        "try{const sv=localStorage.getItem(FKEY);if(sv)Fly.load(sv);}catch(e){}\n",
        "function flySaveNow(){try{localStorage.setItem(FKEY,Fly.dump());}catch(e){}}\n",
        "function flyShow(){$(\"flyStat\").textContent=$(\"flyOn\").checked?`果蝇经验 ${Fly.seen} 音符 · 近期命中率 ${Math.round(Fly.acc*100)}%`:(Fly.seen?`果蝇经验 ${Fly.seen} 音符`:\"\");}\n",
        "function flyTick(){\n",
        "  const t=performance.now(),dt=Math.min(.034,Math.max(.004,(t-flyLast)/1000));flyLast=t;\n",
        "  const on=$(\"flyOn\").checked&&playing&&!editing&&!cal&&ns.length>0;\n",
        "  if(!on){if(flyWas){for(let l=0;l<4;l++)if(flyRel[l]){flyRel[l]=0;active[l]=false;release(l);}flyWas=false;flySaveNow();}return;}\n",
        "  if(!flyWas){flyWas=true;flySnap={...counts};}\n",
        "  const jt=now(),tau=[null,null,null,null];\n",
        "  for(const n of ns){const d=n.t-jt;if(d>.45)break;if(d<-.1||n.missed||n.hit)continue;if(tau[n.lane]===null||Math.abs(d)<Math.abs(tau[n.lane]))tau[n.lane]=d;}\n",
        "  const y=Fly.step(dt,tau,true);\n",
        "  for(let l=0;l<4;l++){flyCool[l]-=dt;\n",
        "    if(flyRel[l]&&jt>=flyRel[l]){flyRel[l]=0;active[l]=false;release(l);}\n",
        "    if(y[l]>.5&&flyCool[l]<=0&&!active[l]){active[l]=true;flyCool[l]=.09;press(l);\n",
        "      const h=ns.find(n=>n.lane===l&&n.holding);flyRel[l]=h?h.t+h.duration-.03:jt+.06;}}\n",
        "  const dP=counts.P-flySnap.P,dG=counts.G-flySnap.G,dO=counts.O-flySnap.O,dM=counts.M-flySnap.M;\n",
        "  if(dP<0||dG<0||dO<0||dM<0)flySnap={...counts};\n",
        "  else if(dP+dG+dO+dM){flySnap={...counts};Fly.reward(dP+.6*dG+.2*dO-dM);\n",
        "    for(let i=0;i<dP+dG+dO;i++)Fly.note(true,1);for(let i=0;i<dM;i++)Fly.note(false,0);}\n",
        "  if(t-flyTxt>400){flyTxt=t;flyShow();}if(t-flySave>5000){flySave=t;flySaveNow();}\n",
        "}\n",
        "$(\"flyOn\").addEventListener(\"change\",()=>{flyShow();flySaveNow();$(\"flyOn\").blur();});\n",
        "$(\"flyReset\").addEventListener(\"click\",()=>{Fly.reset();flySaveNow();flyShow();$(\"flyReset\").blur();});\n",
        "addEventListener(\"pagehide\",flySaveNow);flyShow();\n",
        "\n",
        "/* ---------- Render ---------- */\n",
        "function draw(){\n",
        "  requestAnimationFrame(draw);if(!W)return;\n",
        "  const{cx,hy,hitY,hw}=geom(),ct=vis(),jt=now(),win=1260/$(\"speed\").value,sH=1/(1+Z);\n",
        "  const P=z=>{const s=1/(1+z*Z);return{s,y:hy+(hitY-hy)*s};},X=(l,s)=>cx+(l-1.5)*(hw/2)*s;\n",
        "  analyser.getByteFrequencyData(fdata);flyTick();\n",
        "  let bs=0;for(let i=1;i<6;i++)bs+=fdata[i];bs/=1275;pulse+=(bs-pulse)*(bs>pulse?.5:.1);\n",
        "\n",
        "  // sky + horizon glow + spectrum skyline\n",
        "  let gr=g.createLinearGradient(0,0,0,H);gr.addColorStop(0,\"#04050c\");gr.addColorStop(hy/H,\"#0a0e1c\");gr.addColorStop(1,\"#05060d\");g.fillStyle=gr;g.fillRect(0,0,W,H);\n",
        "  gr=g.createRadialGradient(cx,hy,0,cx,hy,W*.55);gr.addColorStop(0,`rgba(70,95,170,${.08+pulse*.18})`);gr.addColorStop(1,\"rgba(90,130,255,0)\");g.fillStyle=gr;g.fillRect(0,0,W,H);\n",
        "  const nb=56,bw=W/nb;\n",
        "  for(let i=0;i<nb;i++){const v=fdata[1+Math.floor(Math.pow(i/nb,1.5)*90)]/255,bh=2+v*hy*.45;\n",
        "    g.fillStyle=`rgba(110,135,190,${.14+v*.25})`;g.fillRect(i*bw+1,hy-bh,bw-2,bh);g.fillStyle=\"rgba(110,135,190,.06)\";g.fillRect(i*bw+1,hy,bw-2,bh*.45);}\n",
        "  g.globalAlpha=1;\n",
        "\n",
        "  // highway\n",
        "  const hh=hw*sH,eb=hh+(hw-hh)*(H-hy)/(hitY-hy);\n",
        "  gr=g.createLinearGradient(0,hy,0,H);gr.addColorStop(0,\"rgba(9,12,24,.95)\");gr.addColorStop(1,\"rgba(12,14,28,.97)\");\n",
        "  g.fillStyle=gr;g.beginPath();g.moveTo(cx-hh,hy);g.lineTo(cx+hh,hy);g.lineTo(cx+eb,H);g.lineTo(cx-eb,H);g.closePath();g.fill();\n",
        "  g.save();g.shadowColor=\"#4d6db0\";g.shadowBlur=4+pulse*8;g.strokeStyle=`rgba(150,180,235,${.3+pulse*.2})`;g.lineWidth=2;\n",
        "  for(const sg of[-1,1]){g.beginPath();g.moveTo(cx+sg*hh,hy);g.lineTo(cx+sg*eb,H);g.stroke();}g.restore();\n",
        "  g.strokeStyle=\"rgba(255,255,255,.08)\";g.lineWidth=1;\n",
        "  for(let i=1;i<4;i++){const u=(i-2)/2;g.beginPath();g.moveTo(cx+u*hh,hy);g.lineTo(cx+u*eb,H);g.stroke();}\n",
        "\n",
        "  if(cal){drawCal();return;}\n",
        "  if(!chart){g.fillStyle=\"#9fb0e0\";g.textAlign=\"center\";g.font=FONT(\"700 20px\");g.fillText(\"上传音频,点击“识别并生成”\",cx,hy+(hitY-hy)*.5);return;}\n",
        "\n",
        "  // beat grid (also a visual check that the detected tempo matches the song)\n",
        "  if(chart.grid){const per=60/chart.bpm;let k=Math.ceil((ct-.05-chart.offset)/per);\n",
        "    for(let c=0;c<64;c++,k++){const z=(chart.offset+k*per-ct)/win;if(z>1)break;const p=P(z),m=k%4===0;\n",
        "      g.strokeStyle=`rgba(190,210,255,${(m?.35:.13)*(1-z)})`;g.lineWidth=(m?2:1)*p.s+.5;g.beginPath();g.moveTo(cx-hw*p.s,p.y);g.lineTo(cx+hw*p.s,p.y);g.stroke();}}\n",
        "\n",
        "  // lane beams, hit line, receptors\n",
        "  for(let l=0;l<4;l++){flash[l]*=.9;const a=Math.max(active[l]&&!editing?.55:0,flash[l]*.6);if(a<.02)continue;\n",
        "    gr=g.createLinearGradient(0,hitY,0,hy+(hitY-hy)*.2);gr.addColorStop(0,`rgba(${RGB[l]},${a})`);gr.addColorStop(1,`rgba(${RGB[l]},0)`);g.fillStyle=gr;\n",
        "    g.beginPath();g.moveTo(X(l-.5,1),hitY);g.lineTo(X(l+.5,1),hitY);g.lineTo(X(l+.5,sH),hy);g.lineTo(X(l-.5,sH),hy);g.fill();}\n",
        "  g.fillStyle=\"rgba(255,255,255,.7)\";g.fillRect(cx-hw,hitY-1.5,2*hw,3);\n",
        "  g.textAlign=\"center\";\n",
        "  for(let l=0;l<4;l++){const w=hw/2*.86,on=active[l]&&!editing;g.save();g.shadowColor=COL[l];g.shadowBlur=5;g.strokeStyle=on?\"#fff\":COL[l];g.lineWidth=on?3:2;\n",
        "    rr(X(l,1)-w/2,hitY-9,w,18,9);g.stroke();if(on){g.fillStyle=`rgba(${RGB[l]},.4)`;g.fill();}g.restore();\n",
        "    g.fillStyle=editing&&selLane===l?\"#fff\":COL[l];g.font=FONT(\"700 16px\");g.fillText(KEYS[l].toUpperCase(),X(l,1),hitY+34);}\n",
        "\n",
        "  // miss + hold-completion checks\n",
        "  if(playing&&!editing)for(const n of ns){\n",
        "    if(!n.hit&&!n.missed&&n.t<jt-.25){n.missed=true;combo=0;counts.M++;judge={t:\"MISS\",at:performance.now(),k:\"M\"};}\n",
        "    if(n.holding&&jt>=n.t+n.duration){n.holding=false;n.done=true;score+=150;bump();fx(n.lane,true);}}\n",
        "\n",
        "\n",
        "  // notes, far → near\n",
        "  const list=editing||!ns.length?chart.notes:ns,nw=hw*.2;\n",
        "  for(let i=list.length-1;i>=0;i--){const n=list[i],hold=n.type===\"hold\",d=n.duration||0;\n",
        "    if((n.hit&&!hold)||n.done)continue;\n",
        "    const z=(n.t-ct)/win,zE=(n.t+d-ct)/win;if(zE<-.04||z>1.02)continue;\n",
        "    const h=P(n.holding?0:Math.max(z,-.03)),col=COL[n.lane],rgb=RGB[n.lane];\n",
        "    g.globalAlpha=Math.max(0,(n.missed||n.broken?.3:1)*Math.min(1,(1.02-z)*6));\n",
        "    if(hold){const t=P(Math.min(zE,1)),x1=X(n.lane,h.s),x2=X(n.lane,t.s),b1=nw*.6*h.s,b2=nw*.6*t.s;\n",
        "      gr=g.createLinearGradient(0,t.y,0,h.y);gr.addColorStop(0,`rgba(${rgb},.1)`);gr.addColorStop(1,`rgba(${rgb},${n.holding?.6+.25*Math.sin(performance.now()/60):.42})`);\n",
        "      g.fillStyle=gr;g.beginPath();g.moveTo(x1-b1,h.y);g.lineTo(x1+b1,h.y);g.lineTo(x2+b2,t.y);g.lineTo(x2-b2,t.y);g.closePath();g.fill();\n",
        "      g.strokeStyle=col;g.lineWidth=1.5;g.stroke();g.fillStyle=col;rr(x2-b2*1.5,t.y-3,b2*3,6*t.s+2,3);g.fill();}\n",
        "    const x=X(n.lane,h.s),ww=nw*h.s,hn=13*h.s+3;\n",
        "    g.shadowColor=col;g.shadowBlur=6*h.s;\n",
        "    gr=g.createLinearGradient(0,h.y-hn,0,h.y+hn);gr.addColorStop(0,\"#fff\");gr.addColorStop(.35,col);gr.addColorStop(1,`rgba(${rgb},.55)`);\n",
        "    g.fillStyle=gr;rr(x-ww,h.y-hn,ww*2,hn*2,hn);g.fill();g.shadowBlur=0;g.globalAlpha=1;}\n",
        "\n",
        "  // FX\n",
        "  g.globalCompositeOperation=\"lighter\";\n",
        "  for(let i=rings.length-1;i>=0;i--){const r=rings[i];r.r+=3.4;r.l-=.05;if(r.l<=0){rings.splice(i,1);continue;}\n",
        "    g.strokeStyle=`rgba(${r.c},${r.l})`;g.lineWidth=2*r.l;g.beginPath();g.ellipse(r.x,r.y,r.r,r.r*.35,0,0,6.283);g.stroke();}\n",
        "  g.lineCap=\"round\";\n",
        "  for(let i=parts.length-1;i>=0;i--){const p=parts[i];p.x+=p.vx;p.y+=p.vy;p.vy+=.35;p.l-=p.d;if(p.l<=0){parts.splice(i,1);continue;}\n",
        "    g.strokeStyle=`rgba(${p.c},${p.l})`;g.lineWidth=p.w*p.l;g.beginPath();g.moveTo(p.x,p.y);g.lineTo(p.x-p.vx*1.6,p.y-p.vy*1.6);g.stroke();}\n",
        "  g.globalCompositeOperation=\"source-over\";\n",
        "\n",
        "  // HUD\n",
        "  g.textAlign=\"left\";g.fillStyle=\"#7c88ad\";g.font=FONT(\"500 12px\");g.fillText(\"得分\",16,18);\n",
        "  g.fillStyle=\"#fff\";g.font=FONT(\"700 28px\");g.fillText(String(score).padStart(7,\"0\"),16,46);\n",
        "  const T=counts.P+counts.G+counts.O+counts.M;g.textAlign=\"right\";g.fillStyle=\"#7c88ad\";g.font=FONT(\"500 12px\");g.fillText(\"准确率\",W-16,18);\n",
        "  g.fillStyle=\"#fff\";g.font=FONT(\"700 28px\");g.fillText(T?((counts.P+counts.G*.8+counts.O*.5)/T*100).toFixed(1)+\"%\":\"--\",W-16,46);\n",
        "  if(buf){g.fillStyle=\"#6f9bc4\";g.fillRect(0,0,W*Math.min(1,pos()/buf.duration),2);}\n",
        "  cs+=(1-cs)*.18;\n",
        "  if(combo>1){g.save();g.translate(cx,hy+(hitY-hy)*.3);g.scale(cs,cs);g.textAlign=\"center\";g.font=FONT(\"700 38px\");g.fillStyle=\"rgba(255,255,255,.85)\";\n",
        "    g.shadowColor=combo>=30?\"#7fa8c9\":\"#000\";g.shadowBlur=combo>=30?10:4;g.fillText(combo,0,0);g.shadowBlur=0;g.font=FONT(\"500 14px\");g.fillStyle=\"#9fb0e0\";g.fillText(\"连击\",0,22);g.restore();}\n",
        "  const age=performance.now()-judge.at;\n",
        "  if(age<520&&!editing){const f=1-Math.pow(age/520,2);g.save();g.globalAlpha=f;g.translate(cx,hy+(hitY-hy)*.6);g.scale(1+(1-f)*.4,1+(1-f)*.4);g.textAlign=\"center\";g.font=FONT(\"700 24px\");\n",
        "    g.shadowColor={P:\"#e8dcc0\",G:\"#a8cade\",O:\"#cfd8b8\",M:\"#d8a0aa\"}[judge.k]||\"#fff\";g.shadowBlur=7;g.fillStyle=\"#fff\";g.fillText(judge.t,0,0);g.restore();}\n",
        "\n",
        "  if(editing){g.textAlign=\"left\";g.fillStyle=\"#8fa8c4\";g.font=FONT(\"500 14px\");g.fillText(`编辑 · 时间 ${round3(ct)}s · 轨道 ${selLane+1} · 1-4 选轨 A 单点 H 长条 X 删除 ←→ 微调 空格播放`,16,H-14);}\n",
        "  if(result){g.fillStyle=\"rgba(4,5,12,.78)\";g.fillRect(0,0,W,H);g.textAlign=\"center\";\n",
        "    g.fillStyle=\"#c9a227\";g.font=FONT(\"700 64px\");g.fillText(result.rank,cx,H*.38);\n",
        "    g.fillStyle=\"#fff\";g.font=FONT(\"700 30px\");g.fillText(String(score).padStart(7,\"0\"),cx,H*.38+48);\n",
        "    g.fillStyle=\"#9fb0e0\";g.font=FONT(\"500 16px\");g.fillText(`准确率 ${(result.a*100).toFixed(1)}% · 最高连击 ${maxCombo}`,cx,H*.38+80);\n",
        "    g.fillText(`PERFECT ${counts.P} · GREAT ${counts.G} · GOOD ${counts.O} · MISS ${counts.M}`,cx,H*.38+106);\n",
        "    g.fillText(\"点击“播放”再来一次\",cx,H*.38+140);}\n",
        "}\n",
        "draw();\n",
        "\n",
        "// Built-in song list: each track is decoded and charted when selected (playback starts from the play button)\n",
        "let songTok=0;\n",
        "async function loadSong(i){const tok=++songTok;try{\n",
        "  stopAudio();setStatus(\"加载曲目…\");\n",
        "  const el=$(\"song\"+i),bin=atob(el.textContent.trim()),u=new Uint8Array(bin.length);for(let k=0;k<bin.length;k++)u[k]=bin.charCodeAt(k);\n",
        "  const b=await AC.decodeAudioData(u.buffer);if(tok!==songTok)return;\n",
        "  buf=b;feat=null;chart=null;ns=[];off0=0;result=null;$(\"minimp\").value=45;$(\"oct\").value=el.dataset.oct||\"1\";refreshUI();$(\"analyzeBtn\").disabled=true;\n",
        "  const f=await extract(b);if(tok!==songTok)return;\n",
        "  feat=f;regen();$(\"analyzeBtn\").disabled=false;setStatus(el.dataset.name+\" · \"+$(\"status\").textContent);\n",
        "}catch(err){console.error(err);if(tok===songTok)setStatus(\"曲目加载失败,请手动上传音频。\");}}\n",
        "$(\"songSel\").addEventListener(\"change\",()=>{if($(\"songSel\").value!==\"\")loadSong(+$(\"songSel\").value);});\n",
        "loadSong(0);\n",
        "</script>\n",
        "</body></html>"
      ]
    }
  ]
